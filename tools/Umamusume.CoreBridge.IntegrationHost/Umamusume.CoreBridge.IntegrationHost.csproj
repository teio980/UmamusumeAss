<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Umamusume.CoreBridge.IntegrationHost</RootNamespace>
    <AssemblyName>Umamusume.CoreBridge.IntegrationHost</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Umamusume.CoreBridge\Umamusume.CoreBridge.csproj" />
  </ItemGroup>
  <Target Name="StageNativeInputs" BeforeTargets="Build" Condition="'$(NativeDllPath)' != ''">
    <Error Condition="!Exists('$(NativeDllPath)')" Text="Native DLL not found: $(NativeDllPath)" />
    <Error Condition="!Exists('$(FakeAdbPath)')" Text="Fake ADB not found: $(FakeAdbPath)" />
    <Error Condition="!Exists('$(ResourceFilePath)')" Text="Connection resource not found: $(ResourceFilePath)" />
    <MakeDir Directories="$(OutputPath);$(OutputPath)resource" />
    <Copy SourceFiles="$(NativeDllPath)" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="$(FakeAdbPath)" DestinationFolder="$(OutputPath)" />
    <Copy SourceFiles="$(ResourceFilePath)" DestinationFolder="$(OutputPath)resource" />
  </Target>
</Project>
