{
  "name": "shop",
  "schemaVersion": 1,
  "description": "Optional daily shop purchase flow using Select All or OCR matching across the full scrollable list.",
  "referenceWidth": 900,
  "referenceHeight": 1600,
  "templates": {},
  "tasks": {
    "shopProbe": {
      "algorithm": "MatchTemplate",
      "action": "DoNothing",
      "template": "templates/shop/daily_sales_header.png",
      "roi": [580, 60, 300, 110],
      "templThreshold": 0.86,
      "timeoutMs": 1200,
      "postDelay": 450,
      "required": false,
      "next": ["shopSelectAll"],
      "onErrorNext": ["shopNoShopComplete"]
    },
    "shopSelectAll": {
      "template": "templates/shop/select_all.png",
      "roi": [620, 1120, 280, 180],
      "templThreshold": 0.86,
      "timeoutMs": 8000,
      "postDelay": 500,
      "required": false,
      "next": ["shopConfirm"],
      "exceededNext": ["shopSelectItems"],
      "onErrorNext": ["shopBack"]
    },
    "shopSelectItems": {
      "algorithm": "JustReturn",
      "action": "SelectShopItems",
      "required": false,
      "next": ["shopConfirm"],
      "onErrorNext": ["shopBack"]
    },
    "shopConfirm": {
      "template": "templates/shop/confirm_enabled.png",
      "roi": [250, 1250, 430, 240],
      "templThreshold": 0.8,
      "timeoutMs": 5000,
      "postDelay": 1200,
      "required": false,
      "next": ["shopExchangeConfirm"],
      "onErrorNext": ["shopBack"]
    },
    "shopExchangeConfirm": {
      "template": "templates/shop/exchange_confirm.png",
      "roi": [430, 1380, 450, 220],
      "templThreshold": 0.8,
      "timeoutMs": 10000,
      "postDelay": 400,
      "required": false,
      "next": ["shopExchangeComplete"],
      "onErrorNext": ["shopBack"]
    },
    "shopExchangeComplete": {
      "template": "templates/shop/exchange_complete.png",
      "roi": [0, 0, 900, 180],
      "templThreshold": 0.86,
      "timeoutMs": 10000,
      "postDelay": 400,
      "required": false,
      "next": ["shopClose"],
      "onErrorNext": ["shopBack"]
    },
    "shopClose": {
      "template": "templates/shop/exchange_close.png",
      "roi": [250, 1380, 450, 220],
      "templThreshold": 0.8,
      "timeoutMs": 5000,
      "postDelay": 1200,
      "required": false,
      "next": ["shopBack"],
      "onErrorNext": ["shopBack"]
    },
    "shopBack": {
      "template": "templates/shop/back.png",
      "roi": [0, 1250, 220, 220],
      "templThreshold": 0.8,
      "timeoutMs": 5000,
      "postDelay": 1200,
      "required": false,
      "next": ["shopComplete"],
      "onErrorNext": ["shopAndroidBack"]
    },
    "shopAndroidBack": {
      "algorithm": "JustReturn",
      "action": "Back",
      "postDelay": 1200,
      "required": false,
      "next": ["shopComplete"],
      "onErrorNext": ["shopComplete"]
    },
    "shopNoShopComplete": {
      "algorithm": "JustReturn",
      "action": "DoNothing",
      "success": true
    },
    "shopComplete": {
      "algorithm": "JustReturn",
      "action": "DoNothing",
      "success": true
    }
  }
}
