{
  "name": "start_game",
  "start": "StartupMonitor",
  "tasks": {
    "StartupMonitor": {
      "algorithm": "StartupMonitor",
      "action": "StartupMonitor",
      "monitorTasks": [
        "CheckDataDownload",
        "CheckTapToStart",
        "CheckPromoSkip",
        "CheckNotices",
        "CheckBack",
        "CheckRewardsCollectedClose",
        "CheckGameHome",
        "CheckHomeTabOnOtherPage",
        "CheckStartNoticeSkip"
      ],
      "triggerTask": "CheckStartNoticeSkip",
      "triggerChain": [
        "CheckLogoSkip"
      ],
      "timeoutMs": 180000,
      "pollIntervalMs": 100,
      "successConfirmDelayMs": 5000,
      "success": true,
      "onErrorNext": [ "CheckDataDownload" ]
    },
    "CheckGameHome": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/game_home_selected.png",
      "templThreshold": 0.80,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 250, 1400, 400, 200 ],
      "action": "DoNothing",
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "success": true
    },
    "CheckHomeTabOnOtherPage": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/game_home_unselected.png",
      "templThreshold": 0.80,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 250, 1400, 400, 200 ],
      "action": "ClickSelf",
      "postDelay": 1200,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "success": false
    },
    "CheckLogoSkip": {
      "algorithm": "MatchTemplate",
      "template": "templates/start_game/logo_skip.png",
      "templThreshold": 0.75,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 56, 612, 794, 249 ],
      "action": "ClickSelf",
      "postDelay": 500,
      "timeoutMs": 3000,
      "pollIntervalMs": 100,
      "onErrorNext": [ "CheckDataDownload" ],
      "next": [ "CheckDataDownload" ]
    },
    "CheckStartNoticeSkip": {
      "algorithm": "MatchTemplate",
      "template": "templates/start_game/startnotice_skip.png",
      "templThreshold": 0.65,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 68, 444, 764, 369 ],
      "action": "ClickSelf",
      "postDelay": 500,
      "timeoutMs": 3000,
      "pollIntervalMs": 100,
      "onErrorNext": [ "CheckDataDownload" ],
      "next": [ "CheckLogoSkip" ]
    },
    "CheckDataDownload": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/data_download.png",
      "templThreshold": 0.85,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 240, 440, 420, 150 ],
      "action": "ClickRect",
      "specificRect": [ 470, 990, 355, 105 ],
      "postDelay": 2000,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "onErrorNext": [ "CheckPromoSkip" ],
      "next": [ "CheckGameHome" ]
    },
    "CheckPromoSkip": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/promo_skip.png",
      "templThreshold": 0.88,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 750, 1440, 150, 160 ],
      "action": "ClickSelf",
      "postDelay": 1500,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "onErrorNext": [ "CheckNotices" ],
      "next": [ "CheckGameHome" ]
    },
    "CheckNotices": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/notices_close.png",
      "templThreshold": 0.75,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 250, 1420, 400, 100 ],
      "action": "ClickSelf",
      "postDelay": 1500,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "onErrorNext": [ "CheckBack" ],
      "next": [ "CheckGameHome" ]
    },
    "CheckBack": {
      "algorithm": "MatchTemplate",
      "template": "templates/start_game/back.png",
      "templThreshold": 0.85,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 370, 1420, 160, 100 ],
      "action": "ClickSelf",
      "postDelay": 1000,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "onErrorNext": [ "CheckRewardsCollectedClose" ],
      "next": [ "CheckGameHome" ]
    },
    "CheckRewardsCollectedClose": {
      "algorithm": "MatchTemplate",
      "template": "templates/start_game/rewards_collected_close.png",
      "templThreshold": 0.85,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 370, 1100, 160, 100 ],
      "action": "ClickSelf",
      "postDelay": 1000,
      "timeoutMs": 1200,
      "pollIntervalMs": 200,
      "onErrorNext": [ "CheckTapToStart" ],
      "next": [ "CheckGameHome" ]
    },
    "CheckTapToStart": {
      "algorithm": "MatchTemplateColor",
      "template": "templates/start_game/tap_to_start.png",
      "templThreshold": 0.82,
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "roi": [ 80, 1000, 740, 500 ],
      "action": "TapToStart",
      "specificRect": [ 0, 0, 900, 1600 ],
      "postDelay": 4000,
      "timeoutMs": 1500,
      "pollIntervalMs": 200,
      "onErrorNext": [ "WaitForStartup" ],
      "next": [ "CheckGameHome" ]
    },
    "WaitForStartup": {
      "algorithm": "JustReturn",
      "action": "Wait",
      "referenceWidth": 900,
      "referenceHeight": 1600,
      "waitMs": 1000,
      "next": [ "CheckGameHome" ]
    }
  }
}
