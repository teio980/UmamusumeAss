{
  "name": "team-race",
  "schemaVersion": 1,
  "description": "Team Trials pipeline: match a small button template inside an ROI, then click the matched rectangle.",
  "referenceWidth": 900,
  "referenceHeight": 1600,
  "templates": {
    "raceResult": "templates/team_race/race_result.png",
    "randomShop": ""
  },
  "tasks": {
    "home": {
      "template": "templates/start_game/game_home.png",
      "roi": [250, 1400, 400, 200],
      "templThreshold": 0.86,
      "timeoutMs": 5000,
      "postDelay": 1200,
      "next": ["raceTab"]
    },
    "raceTab": {
      "template": "templates/team_race/race_tab.png",
      "roi": [560, 1480, 280, 120],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "postDelay": 1200,
      "next": ["teamTrials"]
    },
    "teamTrials": {
      "template": "templates/team_race/team_trials.png",
      "roi": [80, 980, 420, 300],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "postDelay": 1200,
      "next": ["teamRace"]
    },
    "teamRace": {
      "template": "templates/team_race/team_race.png",
      "roi": [140, 900, 620, 300],
      "templThreshold": 0.86,
      "timeoutMs": 15000,
      "postDelay": 1200,
      "next": ["opponent"]
    },
    "opponent": {
      "template": "templates/team_race/opponent_card.png",
      "roi": [0, 270, 900, 380],
      "templThreshold": 0.92,
      "timeoutMs": 20000,
      "postDelay": 10000,
      "next": ["matchupNext"]
    },
    "matchupNext": {
      "template": "templates/team_race/matchup_next.png",
      "roi": [150, 1240, 600, 230],
      "templThreshold": 0.88,
      "timeoutMs": 20000,
      "postDelay": 1200,
      "next": ["itemRace"]
    },
    "itemRace": {
      "template": "templates/team_race/item_race.png",
      "roi": [400, 1000, 450, 250],
      "templThreshold": 0.88,
      "timeoutMs": 15000,
      "postDelay": 1200,
      "required": false,
      "next": ["quickmode"],
      "onErrorNext": ["quickmode"]
    },
    "quickmode": {
      "template": "templates/team_race/quick_mode_on.png",
      "roi": [320, 1320, 240, 45],
      "templThreshold": 0.88,
      "timeoutMs": 15000,
      "postDelay": 1200,
      "required": false,
      "next": ["seeallresult"],
      "onErrorNext": ["seeallresult"]
    },
    "seeallresult": {
      "template": "templates/team_race/see_all_result.png",
      "roi": [280, 1400, 340, 140],
      "templThreshold": 0.86,
      "timeoutMs": 20000,
      "postDelay": 1200,
      "next": ["whiteskip"]
    },
    "whiteskip": {
      "template": "templates/team_race/whiteskip.png",
      "roi": [790, 1440, 60, 35],
      "templThreshold": 0.86,
      "timeoutMs": 20000,
      "postDelay": 1200,
      "maxTimes": 5,
      "next": ["resultNext"]
    },
    "resultNext": {
      "template": "templates/team_race/result_next.png",
      "roi": [200, 1370, 500, 180],
      "templThreshold": 0.88,
      "timeoutMs": 20000,
      "postDelay": 1200,
      "next": ["newhighscore"]
    },
    "newhighscore": {
      "template": "templates/team_race/new_high_score.png",
      "roi": [150, 500, 150, 60],
      "templThreshold": 0.86,
      "timeoutMs": 20000,
      "postDelay": 1200,
      "required": false,
      "next": ["viewRace"],
      "onErrorNext": ["viewRace"],
      "exceededNext": ["complete"]
    },
    "complete": {
      "algorithm": "JustReturn",
      "action": "DoNothing",
      "success": true
    }
  },
  "timing": {
    "navigationMs": 1200,
    "teamDownloadMs": 10000,
    "nextRaceLoadMs": 10000,
    "playbackLoadMs": 20000,
    "skipSettleMs": 2500,
    "raceTimeoutMs": 60000,
    "shopProbeMs": 1500,
    "pollIntervalMs": 1000,
    "betweenRacesMs": 1200
  }
}
