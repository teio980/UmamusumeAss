{
  "name": "mission-collection",
  "schemaVersion": 1,
  "description": "Open Special Missions, collect all available rewards from every mission tab, and return to Home.",
  "referenceWidth": 900,
  "referenceHeight": 1600,
  "tasks": {
    "home": {
      "template": "templates/start_game/game_home_selected.png",
      "roi": [250, 1400, 400, 200],
      "templThreshold": 0.86,
      "timeoutMs": 2500,
      "pollIntervalMs": 300,
      "postDelay": 1200,
      "next": ["missionIcon"],
      "onErrorNext": ["homeAlt"]
    },
    "homeAlt": {
      "template": "templates/start_game/game_home_unselected.png",
      "roi": [250, 1400, 400, 200],
      "templThreshold": 0.86,
      "timeoutMs": 2500,
      "pollIntervalMs": 300,
      "postDelay": 1200,
      "next": ["missionIcon"],
      "onErrorNext": ["back"]
    },
    "missionIcon": {
      "template": "templates/mission_collection/mission_icon.png",
      "roi": [700, 950, 200, 200],
      "templThreshold": 0.84,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 1500,
      "next": ["dailySelected"]
    },
    "dailySelected": {
      "action": "ClickRect",
      "specificRect": [20, 570, 215, 75],
      "postDelay": 500,
      "next": ["dailyRed"]
    },
    "dailyUnselected": {
      "action": "ClickRect",
      "specificRect": [20, 570, 215, 75],
      "postDelay": 500,
      "next": ["dailyRed"]
    },
    "dailyRed": {
      "action": "DoNothing",
      "template": "templates/mission_collection/red_dot.png",
      "roi": [130, 550, 105, 80],
      "templThreshold": 0.90,
      "timeoutMs": 1500,
      "pollIntervalMs": 300,
      "required": false,
      "next": ["dailyCollectAll"],
      "onErrorNext": ["mainTab"]
    },
    "dailyCollectAll": {
      "template": "templates/mission_collection/collect_all.png",
      "roi": [250, 1260, 450, 200],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["dailyClose"]
    },
    "dailyClose": {
      "template": "templates/mission_collection/reward_close.png",
      "roi": [250, 850, 450, 750],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["mainTab"]
    },
    "mainTab": {
      "action": "ClickRect",
      "specificRect": [235, 570, 215, 75],
      "postDelay": 500,
      "next": ["mainRed"]
    },
    "mainRed": {
      "action": "DoNothing",
      "template": "templates/mission_collection/red_dot.png",
      "roi": [345, 550, 105, 80],
      "templThreshold": 0.90,
      "timeoutMs": 1500,
      "pollIntervalMs": 300,
      "required": false,
      "next": ["mainCollectAll"],
      "onErrorNext": ["titlesTab"]
    },
    "mainCollectAll": {
      "template": "templates/mission_collection/collect_all.png",
      "roi": [250, 1260, 450, 200],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["mainClose"]
    },
    "mainClose": {
      "template": "templates/mission_collection/reward_close.png",
      "roi": [250, 850, 450, 750],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["titlesTab"]
    },
    "titlesTab": {
      "action": "ClickRect",
      "specificRect": [450, 570, 215, 75],
      "postDelay": 500,
      "next": ["titlesRed"]
    },
    "titlesRed": {
      "action": "DoNothing",
      "template": "templates/mission_collection/red_dot.png",
      "roi": [560, 550, 105, 80],
      "templThreshold": 0.90,
      "timeoutMs": 1500,
      "pollIntervalMs": 300,
      "required": false,
      "next": ["titlesCollectAll"],
      "onErrorNext": ["specialTab"]
    },
    "titlesCollectAll": {
      "template": "templates/mission_collection/collect_all.png",
      "roi": [250, 1260, 450, 200],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["titlesClose"]
    },
    "titlesClose": {
      "template": "templates/mission_collection/reward_close.png",
      "roi": [250, 850, 450, 750],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["specialTab"]
    },
    "specialTab": {
      "action": "ClickRect",
      "specificRect": [665, 570, 215, 75],
      "postDelay": 500,
      "next": ["specialRed"]
    },
    "specialRed": {
      "action": "DoNothing",
      "template": "templates/mission_collection/red_dot.png",
      "roi": [775, 550, 105, 80],
      "templThreshold": 0.90,
      "timeoutMs": 1500,
      "pollIntervalMs": 300,
      "required": false,
      "next": ["specialCollectAll"],
      "onErrorNext": ["returnHome"]
    },
    "specialCollectAll": {
      "template": "templates/mission_collection/collect_all.png",
      "roi": [250, 1260, 450, 200],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["specialClose"]
    },
    "specialClose": {
      "template": "templates/mission_collection/reward_close.png",
      "roi": [250, 850, 450, 750],
      "templThreshold": 0.86,
      "timeoutMs": 12000,
      "pollIntervalMs": 300,
      "postDelay": 900,
      "next": ["returnHome"]
    },
    "returnHome": {
      "action": "ClickRect",
      "specificRect": [20, 1300, 150, 100],
      "postDelay": 1000,
      "next": ["homeVerify"],
      "onErrorNext": ["stop"]
    },
    "homeVerify": {
      "action": "DoNothing",
      "template": "templates/start_game/game_home_selected.png",
      "roi": [250, 1400, 400, 200],
      "templThreshold": 0.86,
      "timeoutMs": 5000,
      "pollIntervalMs": 300,
      "success": true
    },
    "back": {
      "algorithm": "JustReturn",
      "action": "Back",
      "postDelay": 600,
      "maxTimes": 3,
      "next": ["home"],
      "exceededNext": ["stop"]
    },
    "stop": {
      "algorithm": "JustReturn",
      "action": "Stop"
    }
  },
  "timing": {
    "navigationMs": 1500,
    "mailboxLoadMs": 1800,
    "collectionSettleMs": 1200,
    "homeTimeoutMs": 5000,
    "homeRetryTimeoutMs": 2500,
    "homeVerifyTimeoutMs": 5000,
    "backAttempts": 3,
    "backSettleMs": 600,
    "pollIntervalMs": 300
  }
}
