{
  "version": 8,
  "configurePresets": [
    {
      "name":          "mingw-debug",
      "displayName":   "MinGW x64 Debug",
      "description":   "Debug build using MinGW-w64 (UCRT64) — the only locally-verified preset",
      "generator":     "MinGW Makefiles",
      "binaryDir":     "${sourceDir}/build/mingw-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_CXX_COMPILER":    "C:/msys64/ucrt64/bin/g++.exe",
        "CMAKE_BUILD_TYPE":      "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name":          "release",
      "displayName":   "Release (MSVC)",
      "description":   "Release build targeting Visual Studio 17 2022 with /MT runtime.",
      "generator":     "Visual Studio 17 2022",
      "architecture":  "x64",
      "binaryDir":     "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    }
  ],
  "testPresets": [
    {
      "name": "mingw-debug",
      "configurePreset": "mingw-debug",
      "environment": {
        "PATH": "C:/msys64/ucrt64/bin;$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
