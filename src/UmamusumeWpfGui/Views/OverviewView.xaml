<UserControl x:Class="UmamusumeWpfGui.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UmamusumeWpfGui.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
             ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
             mc:Ignorable="d">
  <UserControl.Resources>
    <c:NullToVisibilityConverter x:Key="NotNullVisibility" />
    <c:NullToVisibilityConverter x:Key="NullVisibility" Invert="True" />
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="42"
                VerticalAlignment="Top">
      <TextBlock Text="{DynamicResource OverviewTitle}"
                 FontSize="20"
                 FontWeight="Medium" />
      <TextBlock Margin="0,12,0,0"
                 Text="{Binding State}" />

      <TextBlock Margin="0,24,0,0"
                 Text="{DynamicResource OverviewConnectionStatus}"
                 FontSize="20"
                 FontWeight="Medium" />
      <TextBlock Margin="0,12,0,0"
                 Text="{DynamicResource OverviewNoConnection}"
                 Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                 Visibility="{Binding LastVerifiedConnection,
                     Converter={StaticResource NullVisibility}}" />
      <StackPanel Margin="0,12,0,0"
                  Visibility="{Binding LastVerifiedConnection,
                      Converter={StaticResource NotNullVisibility}}">
        <TextBlock Text="{DynamicResource SerialField}" />
        <TextBlock Margin="0,8,0,0"
                   Text="{Binding LastVerifiedConnection.Serial}" />
        <TextBlock Margin="0,12,0,0"
                   Text="{DynamicResource AndroidIdField}" />
        <TextBlock Margin="0,8,0,0"
                   Text="{Binding LastVerifiedConnection.AndroidId}" />
      </StackPanel>

      <TextBlock Margin="0,24,0,0"
                 Text="{DynamicResource OverviewCoreVersion}"
                 FontSize="20"
                 FontWeight="Medium" />
      <TextBlock Margin="0,12,0,0"
                 Text="{Binding CoreVersion}" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
