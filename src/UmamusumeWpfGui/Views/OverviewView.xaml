<UserControl x:Class="UmamusumeWpfGui.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UmamusumeWpfGui.Converters">
  <UserControl.Resources>
    <c:NullToVisibilityConverter x:Key="NotNullVisibility" />
    <c:NullToVisibilityConverter x:Key="NullVisibility" Invert="True" />
  </UserControl.Resources>
  <Grid Background="{DynamicResource SurfaceCanvasBrush}">
    <ScrollViewer Padding="24">
      <StackPanel>
        <TextBlock Text="{DynamicResource OverviewTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,24" />
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
              <TextBlock Text="{DynamicResource OverviewConnectionStatus}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding State}" FontSize="14" Margin="0,12,0,0" />
              <TextBlock Text="{DynamicResource OverviewNoConnection}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" Visibility="{Binding LastVerifiedConnection, Converter={StaticResource NullVisibility}}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Background="{DynamicResource SurfacePanelBrush}" BorderBrush="{DynamicResource BorderDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="20">
            <StackPanel>
              <TextBlock Text="{DynamicResource OverviewCoreVersion}" FontSize="18" FontWeight="SemiBold" />
              <TextBlock Text="{Binding CoreVersion}" Margin="0,12,0,12" />
              <StackPanel Visibility="{Binding LastVerifiedConnection, Converter={StaticResource NotNullVisibility}}">
                <TextBlock Text="{DynamicResource OverviewDevice}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding LastVerifiedConnection.Serial}" FontFamily="Cascadia Mono, Consolas" Margin="0,8,0,0" />
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
