<Window x:Class="UmamusumeWpfGui.Views.RootView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="https://github.com/canton7/Stylet"
        Title="{DynamicResource WindowTitle}"
        Width="960"
        Height="680"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <TabControl>
      <!-- Log tab -->
      <TabItem Header="{DynamicResource TabLog}">
        <ContentControl s:View.Model="{Binding LogViewModel}"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" />
      </TabItem>

      <!-- Settings tab -->
      <TabItem Header="{DynamicResource TabSettings}">
        <ContentControl s:View.Model="{Binding SettingsViewModel}"
                        VerticalContentAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" />
      </TabItem>
    </TabControl>
  </Grid>
</Window>
