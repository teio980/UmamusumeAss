<ui:FluentWindow x:Class="UmamusumeWpfGui.Views.RootView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:s="https://github.com/canton7/Stylet"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource WindowTitle}"
                 Width="1100"
                 Height="650"
                 ExtendsContentIntoTitleBar="True"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       SelectionChanged="OnNavigationSelectionChanged">
      <ui:NavigationView.Header>
        <ui:BreadcrumbBar Margin="42,32,0,0"
                          FontSize="28"
                          FontWeight="DemiBold" />
      </ui:NavigationView.Header>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Tag="0"
                               Content="{DynamicResource NavOverview}"
                               NavigationCacheMode="Enabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Tag="1"
                               Content="{DynamicResource TabLog}"
                               NavigationCacheMode="Enabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DataHistogram24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Tag="2"
                               Content="{DynamicResource TabSettings}"
                               NavigationCacheMode="Disabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>

    <!-- Stylet remains the content bridge for the existing view models. The
         surrounding window and navigation are the upstream WPF-UI shell. -->
    <Grid Grid.Row="1"
          Margin="320,0,0,0"
          Panel.ZIndex="1">
      <ContentControl s:View.Model="{Binding ActiveContent}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Grid>

    <!-- Compatibility binding for the existing navigation contract. -->
    <ListBox ItemsSource="{Binding NavigationItems}"
             Visibility="Collapsed" />

    <ui:TitleBar Grid.Row="0"
                 Title="{DynamicResource WindowTitle}"
                 CloseWindowByDoubleClickOnIcon="True" />
  </Grid>
</ui:FluentWindow>
