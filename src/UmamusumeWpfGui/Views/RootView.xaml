<ui:FluentWindow x:Class="UmamusumeWpfGui.Views.RootView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:c="clr-namespace:UmamusumeWpfGui.Converters"
                 xmlns:local="clr-namespace:UmamusumeWpfGui.Views"
                 xmlns:s="https://github.com/canton7/Stylet"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource WindowTitle}"
                 Icon="/UmamusumeAss;component/Assets/teio-logo.png"
                 Width="1100"
                 Height="650"
                 ExtendsContentIntoTitleBar="True"
                 FontFamily="Segoe UI, Microsoft YaHei UI"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
  <ui:FluentWindow.Resources>
    <c:IntToVisibilityConverter x:Key="NavigationIndexToVisibility" />
    <Style TargetType="{x:Type ui:NavigationViewItem}">
      <Setter Property="Height" Value="64" />
      <Setter Property="Margin" Value="5,3" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ContentTemplate">
        <Setter.Value>
          <DataTemplate>
            <TextBlock Text="{Binding}"
                       FontSize="10"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="62" />
          </DataTemplate>
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ui:NavigationViewItem}">
            <Border x:Name="ItemBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    SnapsToDevicePixels="True">
              <Grid>
                <Border x:Name="HoverBackground"
                        Background="{DynamicResource SidebarHoverBrush}"
                        CornerRadius="10"
                        IsHitTestVisible="False"
                        Opacity="0" />
                <Border x:Name="SelectionIndicator"
                        Width="3"
                        Height="28"
                        Margin="0,0,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        CornerRadius="2" />
                <StackPanel Width="62"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                  <ContentPresenter x:Name="IconPresenter"
                                    Width="24"
                                    Height="24"
                                    Margin="0,0,0,3"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    ContentSource="Icon"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                  <ContentPresenter x:Name="ContentPresenter"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    TextElement.Foreground="{TemplateBinding Foreground}" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="HoverBackground"
                        Property="Opacity"
                        Value="0.10" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="HoverBackground"
                        Property="Background"
                        Value="{DynamicResource SidebarPressedBrush}" />
                <Setter TargetName="HoverBackground"
                        Property="Opacity"
                        Value="0.16" />
              </Trigger>
              <Trigger Property="local:RootView.IsActiveVisual" Value="True">
                <Setter TargetName="ItemBorder"
                        Property="Background"
                        Value="{DynamicResource SidebarSelectedBrush}" />
                <Setter TargetName="HoverBackground"
                        Property="Opacity"
                        Value="0" />
                <Setter TargetName="SelectionIndicator"
                        Property="Background"
                        Value="{DynamicResource AccentPrimaryBrush}" />
                <Setter TargetName="SelectionIndicator"
                        Property="Effect"
                        Value="{DynamicResource SidebarIndicatorGlowEffect}" />
                <Setter Property="Foreground"
                        Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </ui:FluentWindow.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       PaneDisplayMode="LeftFluent"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       IsTopSeparatorVisible="False"
                       IsFooterSeparatorVisible="False"
                       OpenPaneLength="72"
                       Background="{DynamicResource SurfaceSidebarBrush}">
      <ui:NavigationView.Header>
        <ui:BreadcrumbBar Margin="42,32,0,0"
                          FontSize="28"
                          FontWeight="DemiBold"
                          Visibility="Collapsed" />
      </ui:NavigationView.Header>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Tag="3"
                               Content="{DynamicResource TabHachimi}"
                               PreviewMouseLeftButtonDown="OnNavigationItemPreviewMouseDown"
                               Click="OnNavigationItemClick">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" FontSize="22" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Tag="0"
                               Content="{DynamicResource NavOverview}"
                               PreviewMouseLeftButtonDown="OnNavigationItemPreviewMouseDown"
                               Click="OnNavigationItemClick">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Grid24" FontSize="22" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Tag="1"
                               Content="{DynamicResource TabLog}"
                               PreviewMouseLeftButtonDown="OnNavigationItemPreviewMouseDown"
                               Click="OnNavigationItemClick">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DataHistogram24" FontSize="22" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Tag="4"
                               Content="{DynamicResource TabDeveloperTools}"
                               PreviewMouseLeftButtonDown="OnNavigationItemPreviewMouseDown"
                               Click="OnNavigationItemClick">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="WrenchScrewdriver24" FontSize="22" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Tag="2"
                               Content="{DynamicResource TabSettings}"
                               PreviewMouseLeftButtonDown="OnNavigationItemPreviewMouseDown"
                               Click="OnNavigationItemClick">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" FontSize="22" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>
    </ui:NavigationView>





    <Grid Grid.Row="1"
          Margin="72,0,0,0"
          Background="{DynamicResource SurfaceCanvasBrush}"
          Panel.ZIndex="1">
      <ContentControl s:View.Model="{Binding GrassViewModel}"
                      Visibility="{Binding SelectedNavigationIndex,
                          Converter={StaticResource NavigationIndexToVisibility},
                          ConverterParameter=3}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
      <ContentControl s:View.Model="{Binding OverviewViewModel}"
                      Visibility="{Binding SelectedNavigationIndex,
                          Converter={StaticResource NavigationIndexToVisibility},
                          ConverterParameter=0}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
      <ContentControl s:View.Model="{Binding LogViewModel}"
                      Visibility="{Binding SelectedNavigationIndex,
                          Converter={StaticResource NavigationIndexToVisibility},
                          ConverterParameter=1}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
      <ContentControl s:View.Model="{Binding SettingsViewModel}"
                      Visibility="{Binding SelectedNavigationIndex,
                          Converter={StaticResource NavigationIndexToVisibility},
                          ConverterParameter=2}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
      <ContentControl s:View.Model="{Binding DeveloperToolsViewModel}"
                      Visibility="{Binding SelectedNavigationIndex,
                          Converter={StaticResource NavigationIndexToVisibility},
                          ConverterParameter=4}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch" />
    </Grid>


    <ListBox ItemsSource="{Binding NavigationItems}"
             Visibility="Collapsed" />

    <ui:TitleBar Grid.Row="0"
                 Icon="{ui:ImageIcon '/UmamusumeAss;component/Assets/teio-logo.png'}"
                 Title="{DynamicResource WindowTitle}"
                 CloseWindowByDoubleClickOnIcon="True" />
  </Grid>
</ui:FluentWindow>
