<ui:FluentWindow x:Class="UmamusumeWpfGui.Views.RootView"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:s="https://github.com/canton7/Stylet"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="{DynamicResource WindowTitle}"
                 Width="960"
                 Height="680"
                 MinWidth="860"
                 MinHeight="600"
                 ExtendsContentIntoTitleBar="True"
                 Background="{DynamicResource SurfaceCanvasBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <ui:NavigationView x:Name="RootNavigation"
                       Grid.Row="1"
                       Padding="0"
                       Background="{DynamicResource SurfaceSidebarBrush}"
                       PaneDisplayMode="Left"
                       IsBackButtonVisible="Collapsed"
                       IsPaneToggleVisible="False"
                       IsFooterSeparatorVisible="False"
                       IsTopSeparatorVisible="False"
                       OpenPaneLength="248"
                       FrameMargin="0"
                       SelectionChanged="OnNavigationSelectionChanged">
      <ui:NavigationView.Header>
        <StackPanel Margin="42,28,42,20">
          <TextBlock Text="{DynamicResource WindowTitle}"
                     FontSize="28"
                     FontWeight="DemiBold" />
          <TextBlock Text="{DynamicResource AppSubtitle}"
                     Margin="0,6,0,0"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                     FontSize="14" />
        </StackPanel>
      </ui:NavigationView.Header>

      <ui:NavigationView.AutoSuggestBox>
        <ui:AutoSuggestBox PlaceholderText="{DynamicResource NavigationSearchPlaceholder}">
          <ui:AutoSuggestBox.Icon>
            <ui:IconSourceElement>
              <ui:SymbolIconSource Symbol="Search24" />
            </ui:IconSourceElement>
          </ui:AutoSuggestBox.Icon>
        </ui:AutoSuggestBox>
      </ui:NavigationView.AutoSuggestBox>

      <ui:NavigationView.MenuItems>
        <ui:NavigationViewItem Tag="0"
                               Content="{DynamicResource NavOverview}"
                               NavigationCacheMode="Enabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Home24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
        <ui:NavigationViewItem Tag="1"
                               Content="{DynamicResource TabLog}"
                               NavigationCacheMode="Enabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="DocumentBulletList24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.MenuItems>

      <ui:NavigationView.FooterMenuItems>
        <ui:NavigationViewItem Tag="2"
                               Content="{DynamicResource TabSettings}"
                               NavigationCacheMode="Disabled">
          <ui:NavigationViewItem.Icon>
            <ui:SymbolIcon Symbol="Settings24" />
          </ui:NavigationViewItem.Icon>
        </ui:NavigationViewItem>
      </ui:NavigationView.FooterMenuItems>

    </ui:NavigationView>

    <!-- WPF-UI NavigationView owns its internal Frame. The existing Stylet
         content host stays in the same official shell, aligned beside the
         fixed navigation pane so no view-model navigation contract changes. -->
    <Grid Grid.Row="1"
          Margin="248,0,0,0"
          Background="{DynamicResource SurfaceCanvasBrush}">
      <Border BorderBrush="{DynamicResource BorderDefaultBrush}"
              BorderThickness="1,0,0,0">
        <ContentControl s:View.Model="{Binding ActiveContent}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
      </Border>
    </Grid>

    <!-- Compatibility binding retained for callers that inspect the original
         navigation contract; the visible navigation is WPF-UI NavigationView. -->
    <ListBox ItemsSource="{Binding NavigationItems}"
             Visibility="Collapsed" />

    <ui:TitleBar Grid.Row="0"
                 Title="{DynamicResource WindowTitle}"
                 CloseWindowByDoubleClickOnIcon="True" />
  </Grid>
</ui:FluentWindow>
