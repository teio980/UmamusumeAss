<UserControl x:Class="UmamusumeWpfGui.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UmamusumeWpfGui.ViewModels"
             xmlns:m="clr-namespace:UmamusumeWpfGui.Models"
             xmlns:c="clr-namespace:UmamusumeWpfGui.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">

  <UserControl.Resources>
    <c:IntToVisibilityConverter x:Key="IntToVisibility" />
    <c:NullToVisibilityConverter x:Key="NullToVisibility" />
    <!-- A non-null LastVerified snapshot should show the device information card. -->
    <c:NullToVisibilityConverter x:Key="NotNullToVisibility" />
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>

  <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
    <Grid.ColumnDefinitions>
      <!-- Left navigation: exactly 160 px -->
      <ColumnDefinition Width="160" />
      <!-- Right content area -->
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ============================================================
         Left Navigation (160 px)
         ============================================================ -->
    <Border Grid.Column="0"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderThickness="0,0,1,0"
            BorderBrush="{DynamicResource BorderDefaultBrush}">

      <ItemsControl ItemsSource="{Binding MenuItems}"
                    VerticalAlignment="Top"
                    Margin="0,8,0,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="vm:MenuItemViewModel">
            <Border Padding="10,16"
                    BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Cursor="Hand"
                    Background="Transparent"
                    MouseLeftButtonUp="OnNavItemClick">

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 2 px left selection indicator -->
                <Border Grid.Column="0"
                        Width="2"
                        Margin="-10,0,6,0"
            Background="{DynamicResource AccentPrimaryBrush}"
                        Visibility="{Binding IsSelected,
                            Converter={StaticResource BoolToVisibility}}" />

                <!-- Menu item label via DynamicResource -->
                <TextBlock Grid.Column="1"
                           FontSize="14"
                           VerticalAlignment="Center">
                  <TextBlock.Text>
                    <Binding Path="LabelKey"
                             Converter="{x:Static c:StringResourceConverter.Instance}" />
                  </TextBlock.Text>
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground"
                               Value="{DynamicResource TextSecondaryBrush}" />
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <Setter Property="Foreground"
                    Value="{DynamicResource AccentPrimaryBrush}" />
                          <Setter Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ============================================================
         Right Content Area (scrollable, 24 px padding)
         ============================================================ -->
    <ScrollViewer Grid.Column="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Padding="24,16,24,24"
                  Background="Transparent">

      <StackPanel>
        <!-- ============================================================
             CONNECTION PANEL (SelectedMenuIndex == 0)
             ============================================================ -->
        <StackPanel Visibility="{Binding SelectedMenuIndex,
                          Converter={StaticResource IntToVisibility},
                          ConverterParameter=0}">

          <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="{DynamicResource ConnectionTitle}"
                         FontSize="28"
                         FontWeight="DemiBold" />
              <TextBlock Text="{Binding StatusText}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <ui:Button Content="{DynamicResource ConnectButton}"
                      Command="{Binding ConnectCommand}"
                      Height="36"
                      Padding="16,0"
                      Appearance="Primary"
                      Icon="ArrowSync24" />
              <ui:Button Content="{DynamicResource CancelButton}"
                      Command="{Binding CancelConnectCommand}"
                      Height="36"
                      Margin="8,0,0,0"
                      Padding="14,0"
                      Appearance="Secondary"
                      Icon="DismissCircle24" />
              <ui:Button Content="{DynamicResource DisconnectButton}"
                      Command="{Binding DisconnectCommand}"
                      Height="36"
                      Margin="8,0,0,0"
                      Padding="14,0"
                      Appearance="Secondary"
                      Icon="PlugDisconnected24" />
            </StackPanel>
          </Grid>

          <ui:Card Padding="20">
            <StackPanel>

          <!-- ADB Path row -->
          <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="3"
                       Text="{DynamicResource AdbPathLabel}"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <ui:TextBox Grid.Row="1"
                     Grid.Column="0"
                     Text="{Binding DraftAdbPath, UpdateSourceTrigger=PropertyChanged}"
                     Width="300"
                     Height="30"
                     VerticalAlignment="Center" />

            <ui:Button Grid.Row="1"
                    Grid.Column="1"
                    Content="{DynamicResource BrowseButton}"
                    Click="OnBrowseAdbPath"
                    Width="80"
                    Height="30"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Icon="FolderOpen24" />

            <ui:Button Grid.Row="1"
                    Grid.Column="2"
                    Content="{DynamicResource SaveButton}"
                    Command="{Binding SaveCommand}"
                    Width="80"
                    Height="30"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Appearance="Secondary"
                    Icon="Save24" />
          </Grid>

          <!-- Serial row -->
          <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="{DynamicResource SerialLabel}"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <ComboBox Grid.Row="1"
                      Grid.Column="0"
                      Text="{Binding DraftConnectAddress, UpdateSourceTrigger=PropertyChanged}"
                      ItemsSource="{Binding ConnectAddressHistory}"
                      IsEditable="True"
                      Width="400"
                      Height="30"
                      VerticalAlignment="Center"
                      IsTextSearchEnabled="True" />
          </Grid>

          <!-- Auto Detect row -->
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button Grid.Column="0"
                    Content="{DynamicResource AutoDetectButton}"
                    Command="{Binding DetectAdbConfigCommand}"
                    Height="30"
                    Padding="12,0"
                    Appearance="Secondary"
                    Icon="Search24" />

            <CheckBox Grid.Column="1"
                      IsChecked="{Binding DraftAlwaysAutoDetect}"
                      Content="{DynamicResource AlwaysAutoDetectLabel}"
                      Margin="12,0,0,0"
                      VerticalAlignment="Center"
                      FontSize="14" />
          </Grid>

          <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <CheckBox Grid.Row="0"
                      IsChecked="{Binding DraftAutoStartEmulator}"
                      Content="{DynamicResource AutoStartEmulatorLabel}"
                      VerticalAlignment="Center"
                      FontSize="14" />
            <ui:TextBox Grid.Row="1"
                     Text="{Binding DraftEmulatorExecutablePath, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="{DynamicResource EmulatorExecutablePathHint}"
                     Height="30"
                     Margin="0,6,0,0" />
            <StackPanel Grid.Row="2" Margin="0,12,0,0">
              <TextBlock Text="{DynamicResource AutoStartEmulatorWaitSecondsLabel}"
                         Margin="0,0,0,4"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <ui:TextBox Text="{Binding DraftAutoStartEmulatorWaitSeconds, UpdateSourceTrigger=PropertyChanged}"
                       Height="30"
                       Width="120"
                       HorizontalAlignment="Left" />
            </StackPanel>
          </Grid>

          <!-- Profile row (read-only, General only in S1) -->
          <Grid Margin="0,0,0,12">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{DynamicResource ProfileLabel}"
                       Margin="0,0,0,4"
                       Foreground="{DynamicResource TextSecondaryBrush}" />

            <ComboBox Grid.Row="1"
                      IsReadOnly="True"
                      Width="200"
                      Height="30"
                      HorizontalAlignment="Left"
                      Text="General">
              <ComboBox.Items>
                <ComboBoxItem IsSelected="True">General</ComboBoxItem>
              </ComboBox.Items>
            </ComboBox>
          </Grid>

            </StackPanel>
          </ui:Card>

          <!-- ============================================================
               Device Information Card (Last Verified)
               ============================================================ -->
          <ui:Card Margin="0,12,0,0"
                   Padding="16"
                   Visibility="{Binding LastVerified,
                       Converter={StaticResource NotNullToVisibility}}">

            <StackPanel>

              <!-- Card heading -->
              <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                  <TextBlock Text="{DynamicResource DeviceInfoTitle}"
                             FontSize="16"
                             FontWeight="Bold" />
                  <TextBlock Text="{DynamicResource LastVerifiedLabel}"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,2,0,0" />
                </StackPanel>

                <ui:Button Grid.Column="1"
                        Content="{DynamicResource ForgetButton}"
                        Command="{Binding ForgetCommand}"
                        Height="28"
                        Padding="10,0"
                        FontSize="12"
                        VerticalAlignment="Top"
                        Appearance="Secondary"
                        Icon="Delete24" />
              </Grid>

              <!-- Last verified fields (read-only) -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Serial -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource SerialField}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding LastVerified.Serial}"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,0,0" />

                <!-- Android ID -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource AndroidIdField}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding LastVerified.AndroidId}"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,8,0,0" />

                <!-- Android Version -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource AndroidVersionField}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding LastVerified.AndroidVersion}"
                           Margin="8,8,0,0" />

                <!-- Resolution -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource ResolutionField}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Margin="8,8,0,0">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} × {1}">
                      <Binding Path="LastVerified.Width" />
                      <Binding Path="LastVerified.Height" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>

                <!-- Verified at -->
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding LastVerified.VerifiedAt,
                               StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="8,8,0,0" />
              </Grid>
            </StackPanel>
          </ui:Card>

          <!-- ============================================================
               Control Readiness Card (disabled; S2 APIs not yet available)
               ============================================================ -->
          <Border Margin="0,12,0,0"
                  Padding="16"
                  Background="{DynamicResource SurfacePanelBrush}"
                  BorderBrush="{DynamicResource BorderDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  IsEnabled="False"
                  Opacity="0.6">

            <StackPanel>

              <!-- Card heading -->
              <TextBlock Text="{DynamicResource ControlReadinessTitle}"
                         FontSize="16"
                         FontWeight="Bold"
                         Margin="0,0,0,8" />

              <!-- Control session fields (read-only display) -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- State -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{DynamicResource StatusLabel}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding ControlSession.State}"
                           Margin="8,0,0,0" />

                <!-- Target Package ID -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{DynamicResource ProfileLabel}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding ControlSession.TargetPackageId}"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,8,0,0" />

                <!-- Frame dimensions -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{DynamicResource ResolutionField}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Margin="8,8,0,0">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} × {1}">
                      <Binding Path="ControlSession.FrameWidth" />
                      <Binding Path="ControlSession.FrameHeight" />
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>

                <!-- Geometry generation -->
                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{DynamicResource LastDetectedEmulatorLabel}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,8,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding ControlSession.GeometryGeneration}"
                           Margin="8,8,0,0" />
              </Grid>

              <!-- Action buttons (all disabled; S2 not available) -->
              <WrapPanel Margin="0,12,0,0">
                <ui:Button Content="{DynamicResource VerifyGameButton}"
                        IsEnabled="False"
                        Height="28"
                        Padding="10,0"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Appearance="Secondary" />

                <ui:Button Content="{DynamicResource CaptureScreenButton}"
                        IsEnabled="False"
                        Height="28"
                        Padding="10,0"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Appearance="Secondary" />

                <ui:Button Content="{DynamicResource TapTestButton}"
                        IsEnabled="False"
                        Height="28"
                        Padding="10,0"
                        FontSize="12"
                        Margin="0,0,8,0"
                        Appearance="Secondary" />

                <ui:Button Content="{DynamicResource SwipeTestButton}"
                        IsEnabled="False"
                        Height="28"
                        Padding="10,0"
                        FontSize="12"
                        Appearance="Secondary" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- ============================================================
             LANGUAGE PANEL (SelectedMenuIndex == 1)
             ============================================================ -->
        <StackPanel Visibility="{Binding SelectedMenuIndex,
                          Converter={StaticResource IntToVisibility},
                          ConverterParameter=1}">

          <TextBlock Text="{DynamicResource LanguageTitle}"
                     FontSize="16"
                     FontWeight="Bold"
                     Margin="0,0,0,8" />

          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ComboBox Grid.Row="0"
                      SelectedItem="{Binding SelectedLanguage}"
                      Width="200"
                      Height="30"
                      HorizontalAlignment="Left"
                      IsReadOnly="True">
              <ComboBox.Items>
                <ComboBoxItem>en-US</ComboBoxItem>
                <ComboBoxItem>zh-CN</ComboBoxItem>
              </ComboBox.Items>
            </ComboBox>

            <TextBlock Grid.Row="1"
                       Text="{DynamicResource LanguageHint}"
                        Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       FontStyle="Italic" />
          </Grid>
        </StackPanel>

        <!-- ============================================================
             SYSTEM PANEL (SelectedMenuIndex == 2)
             ============================================================ -->
        <StackPanel Visibility="{Binding SelectedMenuIndex,
                          Converter={StaticResource IntToVisibility},
                          ConverterParameter=2}">

          <TextBlock Text="{DynamicResource SystemTitle}"
                     FontSize="16"
                     FontWeight="Bold"
                     Margin="0,0,0,8" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="180" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Core Version -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       Text="{DynamicResource CoreVersionLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <TextBlock Grid.Row="0" Grid.Column="1"
                       Text="{Binding CoreVersion}"
                       TextTrimming="CharacterEllipsis" />

            <!-- Resource Path -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       Text="{DynamicResource ResourcePathLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Text="{Binding ResourcePath}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0" />

            <!-- Current ADB Path -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       Text="{DynamicResource CurrentAdbPathLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" Grid.Column="1"
                       Text="{Binding DraftAdbPath}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0" />

            <!-- Last Detected Emulator -->
            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{DynamicResource LastDetectedEmulatorLabel}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Margin="0,8,0,0" />
            <TextBlock Grid.Row="3" Grid.Column="1"
                       Text="{Binding LastDetectedEmulator}"
                       TextTrimming="CharacterEllipsis"
                       Margin="0,8,0,0" />
          </Grid>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>

</UserControl>
