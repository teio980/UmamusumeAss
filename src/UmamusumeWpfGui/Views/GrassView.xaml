<UserControl x:Class="UmamusumeWpfGui.Views.GrassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UmamusumeWpfGui.ViewModels"
             xmlns:m="clr-namespace:UmamusumeWpfGui.Models"
             xmlns:views="clr-namespace:UmamusumeWpfGui.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="PanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <!-- Keep task rows clear of the overlaid scrollbar in narrow layouts. -->
      <Setter Property="Margin" Value="0,2,10,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TaskLogGroupStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="24"
        TextElement.FontSize="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{DynamicResource GrassTitle}"
                   FontSize="20"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding PageStatus}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Border HorizontalAlignment="Right"
              Padding="10,6"
              Background="{DynamicResource SurfaceRaisedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <TextBlock Text="{Binding TaskCountSummary}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>
    </Grid>

    <Grid x:Name="HachimiWorkspace" Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*" />
        <ColumnDefinition Width="3*" />
      </Grid.ColumnDefinitions>


      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10" Style="{StaticResource PanelBorderStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="4,2,4,8"
                       Text="{DynamicResource GrassTaskQueue}"
                       FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="4,8,4,2"
                       Text="{DynamicResource GrassTaskReorderHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid>
              <ListBox x:Name="TaskQueueListBox"
                       ItemsSource="{Binding Tasks}"
                       SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource TaskListItemStyle}"
                       BorderThickness="0"
                       Background="Transparent"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GrassTaskItemViewModel}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Status}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Canvas x:Name="TaskQueueOverlay"
                      Panel.ZIndex="10"
                      IsHitTestVisible="False">
                <Border x:Name="TaskDropIndicator"
                        Height="3"
                        Background="{DynamicResource AccentPrimaryBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                <Border x:Name="TaskDragPreview"
                        Padding="10,8"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Opacity="0.96"
                        Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Margin="0,2,0,0"
                                 Text="{Binding Status}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}"
                              Focusable="False" />
                  </Grid>
                </Border>
              </Canvas>
            </Grid>
          </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
          <ui:Button Content="{DynamicResource GrassAddTask}"
                     Command="{Binding AddTaskCommand}"
                     IsEnabled="{Binding CanAddTask}"
                     Appearance="Secondary"
                     Icon="Add24" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassCopyTask}"
                     Command="{Binding CopyTaskCommand}"
                     Appearance="Secondary"
                     Icon="Copy24" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassDeleteTask}"
                     Command="{Binding RemoveTaskCommand}"
                     Appearance="Secondary"
                     Icon="Delete24" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
          <ui:Button Content="{DynamicResource GrassSelectAll}"
                     Command="{Binding SelectAllCommand}"
                     Appearance="Secondary" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassInvertSelection}"
                     Command="{Binding InvertSelectionCommand}"
                     Appearance="Secondary" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal">
          <ui:Button Width="96"
                     Content="{DynamicResource GrassStart}"
                     Command="{Binding StartCommand}"
                     IsEnabled="{Binding CanStartQueue}"
                     Appearance="Primary" />
          <ui:Button Width="96"
                     Margin="8,0,0,0"
                     Content="{DynamicResource GrassStop}"
                     Command="{Binding StopCommand}"
                     IsEnabled="{Binding CanStopQueue}"
                     Appearance="Secondary" />
        </StackPanel>
      </Grid>

      <Border Grid.Column="1"
              Margin="8,0,0,0"
              Padding="10"
              Style="{StaticResource PanelBorderStyle}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="4,2,4,10">
            <TextBlock Text="{DynamicResource GrassTaskLogTitle}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,3,0,0"
                       Text="{Binding HachimiTaskLog.RunStatus}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>

          <ScrollViewer x:Name="HachimiTaskLogScrollViewer"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding HachimiTaskLog.QueueEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type m:HachimiTaskLogEntry}">
                    <Border Margin="0,0,0,8"
                            Padding="8,6"
                            Background="{DynamicResource SurfaceCanvasBrush}"
                            CornerRadius="5">
                      <StackPanel>
                        <TextBlock Text="{Binding Step}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Message}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <ItemsControl ItemsSource="{Binding HachimiTaskLog.Tasks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:HachimiTaskLogGroupViewModel}">
                    <Border Style="{StaticResource TaskLogGroupStyle}">
                      <StackPanel>
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding TaskName}"
                                     FontWeight="Medium" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding StatusText}"
                                     Foreground="{DynamicResource AccentPrimaryBrush}" />
                        </Grid>
                        <TextBlock Margin="0,6,0,0"
                                   Text="{DynamicResource GrassTaskLogWaiting}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding IsWaiting, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl Margin="0,8,0,0"
                                      ItemsSource="{Binding Entries}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:HachimiTaskLogEntry}">
                              <Border Margin="0,0,0,6"
                                      Padding="8,6"
                                      Background="{DynamicResource SurfaceCanvasBrush}"
                                      CornerRadius="5">
                                <StackPanel>
                                  <TextBlock Text="{Binding Step}"
                                             FontSize="11"
                                             Foreground="{DynamicResource TextSecondaryBrush}" />
                                  <TextBlock Margin="0,2,0,0"
                                             Text="{Binding Message}"
                                             TextWrapping="Wrap" />
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Margin="4,8,4,4"
                         Text="{DynamicResource GrassTaskLogEmpty}"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         Visibility="{Binding HachimiTaskLog.IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1"
          Panel.ZIndex="20"
          Background="{DynamicResource SurfaceCanvasBrush}"
          Visibility="{Binding IsTaskSettingsPage,
                               Converter={StaticResource BoolToVisibility}}">
      <views:HachimiTaskSettingsView DataContext="{Binding}" />
    </Grid>
  </Grid>
</UserControl>
