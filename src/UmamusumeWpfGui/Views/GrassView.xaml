<UserControl x:Class="UmamusumeWpfGui.Views.GrassView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="clr-namespace:UmamusumeWpfGui.Models"
             xmlns:vm="clr-namespace:UmamusumeWpfGui.ViewModels"
             xmlns:tasksettings="clr-namespace:UmamusumeWpfGui.ViewModels.Tasks"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:views="clr-namespace:UmamusumeWpfGui.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <Style x:Key="PanelBorderStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="TaskListItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        </Trigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{DynamicResource GrassTitle}"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Margin="0,4,0,0"
                   Text="{Binding PageStatus}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </StackPanel>
      <Border HorizontalAlignment="Right"
              Padding="10,6"
              Background="{DynamicResource SurfaceRaisedBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}"
              BorderThickness="1"
              CornerRadius="6">
        <TextBlock Text="{Binding TaskCountSummary}"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
      </Border>
    </Grid>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*" />
        <ColumnDefinition Width="1.15*" />
        <ColumnDefinition Width="1.2*" />
      </Grid.ColumnDefinitions>


      <Grid Grid.Column="0" Margin="0,0,8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="10" Style="{StaticResource PanelBorderStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="4,2,4,8"
                       Text="{DynamicResource GrassTaskQueue}"
                       FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="4,8,4,2"
                       Text="{DynamicResource GrassTaskReorderHint}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Grid>
              <ListBox x:Name="TaskQueueListBox"
                       ItemsSource="{Binding Tasks}"
                       SelectedItem="{Binding SelectedTask, Mode=TwoWay}"
                       ItemContainerStyle="{StaticResource TaskListItemStyle}"
                       BorderThickness="0"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type vm:GrassTaskItemViewModel}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                        <TextBlock Margin="0,2,0,0"
                                   Text="{Binding Status}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                      </StackPanel>
                      <CheckBox Grid.Column="1"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Canvas x:Name="TaskQueueOverlay"
                      Panel.ZIndex="10"
                      IsHitTestVisible="False">
                <Border x:Name="TaskDropIndicator"
                        Height="3"
                        Background="{DynamicResource AccentPrimaryBrush}"
                        CornerRadius="2"
                        Visibility="Collapsed" />
                <Border x:Name="TaskDragPreview"
                        Padding="10,8"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Opacity="0.96"
                        Visibility="Collapsed">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                      <TextBlock Margin="0,2,0,0"
                                 Text="{Binding Status}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsEnabled}"
                              Focusable="False" />
                  </Grid>
                </Border>
              </Canvas>
            </Grid>
          </DockPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
          <ui:Button Content="{DynamicResource GrassAddTask}"
                     Command="{Binding AddTaskCommand}"
                     IsEnabled="{Binding CanAddTask}"
                     Appearance="Secondary"
                     Icon="Add24" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassCopyTask}"
                     Command="{Binding CopyTaskCommand}"
                     Appearance="Secondary"
                     Icon="Copy24" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassDeleteTask}"
                     Command="{Binding RemoveTaskCommand}"
                     Appearance="Secondary"
                     Icon="Delete24" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal">
          <ui:Button Content="{DynamicResource GrassSelectAll}"
                     Command="{Binding SelectAllCommand}"
                     Appearance="Secondary" />
          <ui:Button Margin="6,0,0,0"
                     Content="{DynamicResource GrassInvertSelection}"
                     Command="{Binding InvertSelectionCommand}"
                     Appearance="Secondary" />
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,14,0,0" Orientation="Horizontal">
          <ui:Button Width="96"
                     Content="{DynamicResource GrassStart}"
                     Command="{Binding StartCommand}"
                     IsEnabled="{Binding CanStartQueue}"
                     Appearance="Primary" />
          <ui:Button Width="96"
                     Margin="8,0,0,0"
                     Content="{DynamicResource GrassStop}"
                     Command="{Binding StopCommand}"
                     IsEnabled="{Binding CanStopQueue}"
                     Appearance="Secondary" />
        </StackPanel>
      </Grid>


      <Grid Grid.Column="1" Margin="8,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="18" Style="{StaticResource PanelBorderStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="{DynamicResource GrassSettings}"
                         FontWeight="SemiBold" />
              <StackPanel Margin="0,18,0,0"
                          Visibility="{Binding IsTaskSettings, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding SelectedTaskTitle}"
                           FontSize="18"
                           FontWeight="SemiBold" />
                <TextBlock Margin="0,6,0,0"
                           Text="{Binding SelectedTaskDescription}"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <ContentControl Margin="0,20,0,0"
                                Content="{Binding SelectedTask.Settings}">
                  <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type tasksettings:StartGameTaskSettingsViewModel}">
                      <taskviews:StartGameTaskSettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type tasksettings:TeamRaceTaskSettingsViewModel}">
                      <taskviews:TeamRaceTaskSettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type tasksettings:DailyRaceTaskSettingsViewModel}">
                      <taskviews:DailyRaceTaskSettingsView />
                    </DataTemplate>
                    <DataTemplate DataType="{x:Type tasksettings:MailCollectionTaskSettingsViewModel}">
                      <taskviews:MailCollectionTaskSettingsView />
                    </DataTemplate>
                  </ContentControl.Resources>
                </ContentControl>
                <Border Margin="0,20,0,0"
                        Padding="12"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6">
                  <StackPanel>
                    <TextBlock Text="{DynamicResource GrassPlaceholderTitle}"
                               FontWeight="Medium" />
                    <TextBlock Margin="0,6,0,0"
                               Text="{DynamicResource GrassPlaceholderMessage}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <ContentControl Margin="0,18,0,0"
                              Content="{Binding HachimiShopSettings}"
                              Visibility="{Binding IsGlobalSettings, Converter={StaticResource BoolToVisibility}}">
                <ContentControl.Resources>
                  <DataTemplate DataType="{x:Type vm:HachimiShopSettingsViewModel}">
                    <views:HachimiShopSettingsView />
                  </DataTemplate>
                </ContentControl.Resources>
              </ContentControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" Orientation="Horizontal">
          <RadioButton Content="{DynamicResource GrassTaskSettings}"
                       GroupName="GrassSettingsMode"
                       IsChecked="{Binding IsTaskSettings, Mode=TwoWay}" />
          <RadioButton Margin="14,0,0,0"
                       Content="{DynamicResource GrassGlobalSettings}"
                       GroupName="GrassSettingsMode"
                       IsChecked="{Binding IsGlobalSettings, Mode=TwoWay}" />
        </StackPanel>

        <Border Grid.Row="2"
                Margin="0,10,0,0"
                Padding="10"
                Background="{DynamicResource SurfaceRaisedBrush}"
                BorderBrush="{DynamicResource BorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="6">
          <TextBlock Text="{DynamicResource GrassTodayHint}"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
        </Border>
      </Grid>


      <Grid Grid.Column="2" Margin="8,0,0,0">
        <Border Padding="14" Style="{StaticResource PanelBorderStyle}">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Margin="0,0,0,8"
                       Text="{DynamicResource GrassLogs}"
                       FontWeight="SemiBold" />
            <ListBox x:Name="ScriptLogListBox"
                     ItemsSource="{Binding ScriptLogs}"
                     BorderThickness="0"
                     Background="Transparent"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type m:LogEntry}">
                  <StackPanel Margin="0,4">
                    <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}"
                               FontSize="10"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Type}"
                               FontSize="11"
                               FontWeight="Medium" />
                    <Expander Margin="0,2,0,0"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Header="{Binding Details}"
                              IsExpanded="False">
                      <Expander.HeaderTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding}"
                                     FontSize="10.5"
                                     LineHeight="15"
                                     MaxHeight="60"
                                     TextWrapping="Wrap"
                                     TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextSecondaryBrush}" />
                        </DataTemplate>
                      </Expander.HeaderTemplate>
                      <TextBlock Text="{Binding Details}"
                                 FontSize="10.5"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Expander>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock DockPanel.Dock="Bottom"
                       Margin="0,12,0,0"
                       Text="{DynamicResource GrassLogHint}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
