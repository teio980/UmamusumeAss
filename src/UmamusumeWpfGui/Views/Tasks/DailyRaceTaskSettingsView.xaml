<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.DailyRaceTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <DataTemplate x:Key="ComboOptionTemplate">
      <TextBlock Text="{Binding Label}"
                 TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel TextElement.FontSize="12">
      <TextBlock Text="{DynamicResource GrassDailyRaceSettingsTitle}"
                 FontWeight="Medium" />
      <TextBlock Margin="0,14,0,0"
                 Text="{DynamicResource GrassDailyRaceModeLabel}" />
      <ComboBox
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding Modes}"
                ItemTemplate="{StaticResource ComboOptionTemplate}"
                SelectedValuePath="Value"
                SelectedValue="{Binding Mode, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Margin="0,14,0,0"
                 Text="{DynamicResource GrassDailyRaceDifficultyLabel}" />
      <ComboBox
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding Difficulties}"
                ItemTemplate="{StaticResource ComboOptionTemplate}"
                SelectedValuePath="Value"
                SelectedValue="{Binding Difficulty, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Margin="0,14,0,0"
                 Text="{DynamicResource GrassDailyRaceCountLabel}" />
      <ui:TextBox Width="120"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Text="{Binding RaceCountText, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,14,0,0"
                 Text="{DynamicResource GrassDailyRaceTraineeLabel}" />
      <taskviews:TraineePickerView Margin="0,6,0,0" />
      <TextBlock Margin="0,8,0,0"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
  </StackPanel>
</UserControl>
