<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.NormalCareerSkillSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </UserControl.Resources>
  <Border Style="{DynamicResource SettingCardStyle}"
          HorizontalAlignment="Stretch"
          Visibility="{Binding IsCareerModeActive, Converter={StaticResource BoolToVisibility}}">
    <StackPanel>
      <TextBlock Text="{DynamicResource GrassNormalCareerSkillsLabel}"
                 Style="{DynamicResource SettingCardTitleStyle}" />
      <TextBlock Margin="0,4,0,0"
                 Text="{DynamicResource GrassNormalCareerSkillsHint}"
                 Style="{DynamicResource SettingCardDescriptionStyle}"
                 TextWrapping="Wrap" />
      <ui:TextBox Margin="0,10,0,0"
                  PlaceholderText="{DynamicResource GrassNormalCareerSkillSearchPlaceholder}"
                  Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
      <ListBox Height="220"
               Margin="0,6,0,0"
               BorderThickness="1"
               ScrollViewer.CanContentScroll="True"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               ItemsSource="{Binding FilteredSkills}"
               SelectedItem="{Binding SelectedAvailableSkill, Mode=TwoWay}">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Margin="4,3"
                       Text="{Binding Label}"
                       TextWrapping="Wrap" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <ui:Button Margin="0,8,0,0"
                 HorizontalAlignment="Right"
                 Content="{DynamicResource GrassNormalCareerSkillAddTarget}"
                 Command="{Binding AddSelectedSkillCommand}"
                 Appearance="Secondary" />
      <TextBlock Margin="0,10,0,0"
                 Text="{DynamicResource GrassNormalCareerSkillTargetsLabel}"
                 Style="{DynamicResource SettingCardTitleStyle}" />
      <TextBlock Margin="0,4,0,0"
                 Foreground="{DynamicResource TextSecondaryBrush}">
        <Run Text="{DynamicResource GrassNormalCareerSkillTargetCountPrefix}" />
        <Run Text="{Binding SelectedTargetSkillCount, Mode=OneWay}" />
      </TextBlock>
      <Grid Margin="0,6,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <ListBox Grid.Column="0"
                 Height="150"
                 BorderThickness="1"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 ItemsSource="{Binding TargetSkills}"
                 SelectedItem="{Binding SelectedTargetSkill, Mode=TwoWay}">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <TextBlock Margin="4,3"
                         Text="{Binding Label}"
                         TextWrapping="Wrap" />
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Margin="8,0,0,0">
          <ui:Button Content="{DynamicResource GrassMoveUp}"
                     Command="{Binding MoveSelectedSkillUpCommand}"
                     IsEnabled="{Binding CanMoveSelectedSkillUp}"
                     Appearance="Secondary" />
          <ui:Button Margin="0,6,0,0"
                     Content="{DynamicResource GrassMoveDown}"
                     Command="{Binding MoveSelectedSkillDownCommand}"
                     IsEnabled="{Binding CanMoveSelectedSkillDown}"
                     Appearance="Secondary" />
          <ui:Button Margin="0,6,0,0"
                     Content="{DynamicResource GrassRemove}"
                     Command="{Binding RemoveSelectedSkillCommand}"
                     Appearance="Secondary" />
        </StackPanel>
      </Grid>
    </StackPanel>
  </Border>
</UserControl>
