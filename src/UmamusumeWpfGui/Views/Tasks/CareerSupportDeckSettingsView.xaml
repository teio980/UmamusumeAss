<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.CareerSupportDeckSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:UmamusumeWpfGui.Converters"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <DataTemplate x:Key="ComboOptionTemplate"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:IntToVisibilityConverter x:Key="NoSelectedSupportCardsVisibilityConverter" />
  </UserControl.Resources>
  <StackPanel TextElement.FontSize="12">
    <Border Style="{DynamicResource SettingCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0" Symbol="PeopleCommunity24" Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{DynamicResource GrassCareerSupportDeckModeLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <ComboBox Margin="0,10,0,0" HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding SupportDeckModes}" ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value" SelectedValue="{Binding SupportDeckMode, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            IsEnabled="{Binding IsSupportPresetMode}">
      <StackPanel>
      <TextBlock Text="{DynamicResource GrassCareerSupportDeckPresetLabel}"
                 Style="{DynamicResource SettingCardTitleStyle}" />
      <ComboBox Margin="0,6,0,0" HorizontalContentAlignment="Stretch"
                ItemsSource="{Binding SupportDeckPresets}" ItemTemplate="{StaticResource ComboOptionTemplate}"
                SelectedValuePath="Value" SelectedValue="{Binding SelectedSupportDeckPresetValue, UpdateSourceTrigger=PropertyChanged}" />
      <StackPanel Margin="0,10,0,0"
                  Visibility="{Binding IsSupportTypeComposition, Converter={StaticResource BoolToVisibility}}">
        <TextBlock Text="{DynamicResource GrassSupportTypeCountHint}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
        <TextBlock Text="{Binding SupportTypeTotal, StringFormat={}{0} / 6}" Margin="0,6,0,0" FontWeight="SemiBold" />
        <WrapPanel Margin="0,8,0,0">
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypeSpeed}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportSpeedCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypeStamina}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportStaminaCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypePower}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportPowerCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypeGuts}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportGutsCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypeWit}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportWitCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
          <StackPanel Width="120" Margin="0,0,12,8">
            <TextBlock Text="{DynamicResource GrassSupportTypeFriend}" Margin="0,0,0,4" />
            <ui:NumberBox Value="{Binding SupportFriendCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Minimum="0" Maximum="6" MaxDecimalPlaces="0" SmallChange="1"
                          SpinButtonPlacementMode="Inline" />
          </StackPanel>
        </WrapPanel>
        <TextBlock Text="{DynamicResource GrassSupportTypeCountInvalid}" Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsSupportTypeTotalInvalid, Converter={StaticResource BoolToVisibility}}" />
      </StackPanel>
      <Expander Margin="0,10,0,0" Header="{Binding FriendSupportCardDrawerHeader}" IsExpanded="False"
                IsEnabled="{Binding IsFriendSupportCardSettingEnabled}">
        <StackPanel Margin="6,6,0,0">
          <TextBlock Margin="0,6,0,0" Text="{Binding SelectedFriendSupportCardCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
          <ui:TextBox Margin="0,6,0,0"
                      Text="{Binding FriendSupportCardSearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="{DynamicResource GrassCareerSearchCardsPlaceholder}" />
          <ComboBox Margin="0,6,0,0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding SupportCardTypeOptions}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}" SelectedValuePath="Value"
                    SelectedValue="{Binding FriendSupportCardTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
          <ListBox Height="150" Margin="0,6,0,0" BorderThickness="1" HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding FilteredFriendSupportCardOptions}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="58" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <Image Grid.Column="1" Width="36" Height="46" Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                  <StackPanel Grid.Column="2" Margin="8,4,4,4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><TextBlock Margin="0,2,0,0" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Expander>
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            IsEnabled="{Binding IsManualSupportDeck}">
      <StackPanel>
      <TextBlock Text="{DynamicResource GrassCareerManualSupportCardsLabel}"
                 Style="{DynamicResource SettingCardTitleStyle}" />
      <Expander Margin="0,8,0,0" Header="{Binding SupportCardDrawerHeader}" IsExpanded="False">
        <StackPanel Margin="6,6,0,0">
          <TextBlock Margin="0,0,0,6" Text="{Binding SelectedSupportCardCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
          <ui:TextBox Text="{Binding SupportCardSearchText, UpdateSourceTrigger=PropertyChanged}"
                      PlaceholderText="{DynamicResource GrassCareerSearchCardsPlaceholder}" />
          <ComboBox Margin="0,6,0,0" HorizontalContentAlignment="Stretch" ItemsSource="{Binding SupportCardTypeOptions}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}" SelectedValuePath="Value"
                    SelectedValue="{Binding SupportCardTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
          <ListBox Height="150" Margin="0,6,0,0" BorderThickness="1" HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling" ItemsSource="{Binding FilteredSupportCardOptions}">
            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /></Style></ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid MinHeight="58" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                  <CheckBox Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                  <Image Grid.Column="1" Width="36" Height="46" Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                  <StackPanel Grid.Column="2" Margin="8,4,4,4"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /><TextBlock Margin="0,2,0,0" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Margin="0,8,0,0"
                     Text="{DynamicResource GrassCareerSelectedSupportCardsLabel}" />
          <TextBlock Margin="0,4,0,0"
                     Text="{DynamicResource GrassCareerNoSupportCardsSelectedLabel}"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     Visibility="{Binding SelectedSupportCardCount, Converter={StaticResource NoSelectedSupportCardsVisibilityConverter}, ConverterParameter=0}" />
          <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding SelectedSupportCardOptions}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Width="136" Margin="0,0,8,8" Padding="6"
                        BorderBrush="{DynamicResource TextSecondaryBrush}" BorderThickness="1" CornerRadius="8">
                  <StackPanel>
                    <Image Width="108" Height="132" HorizontalAlignment="Center"
                           Source="{Binding ImageUrl}" Stretch="UniformToFill" />
                    <TextBlock Margin="0,6,0,0" Text="{Binding Label}" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="38" />
                    <TextBlock Margin="0,3,0,0" Text="{Binding Type}" Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,2,0,0" Text="{Binding SupportCardId, StringFormat='#{0}'}"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <ui:Button Margin="0,6,0,0" Content="{DynamicResource GrassRemove}"
                               Command="{Binding DataContext.RemoveSupportCardCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                               CommandParameter="{Binding}" Appearance="Secondary" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
