<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.TeamRaceTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <StackPanel>
      <TextBlock Text="{DynamicResource GrassTeamRaceSettingsTitle}"
                 FontWeight="Medium" />
      <TextBlock Margin="0,12,0,0"
                 Text="{DynamicResource GrassTeamRaceCountLabel}" />
      <ui:TextBox Width="120"
                  Margin="0,6,0,0"
                  HorizontalAlignment="Left"
                  Text="{Binding RaceCountText, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox Margin="0,12,0,0"
                IsChecked="{Binding StopWhenTicketsEmpty}">
        <TextBlock Text="{DynamicResource GrassTeamRaceStopWhenTicketsEmpty}"
                   TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Margin="0,8,0,0"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
  </StackPanel>
</UserControl>
