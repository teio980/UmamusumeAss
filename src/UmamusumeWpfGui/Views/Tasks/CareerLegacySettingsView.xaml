<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.CareerLegacySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <DataTemplate x:Key="ComboOptionTemplate">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel TextElement.FontSize="12">
    <Border Style="{DynamicResource SettingCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0"
                       Symbol="History24"
                       Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{DynamicResource GrassCareerLegacyModeLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <ComboBox Margin="0,10,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding LegacySelectionModes}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding LegacySelectionMode, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}">
      <StackPanel>
        <CheckBox IsChecked="{Binding UseCachedLegacy}">
          <TextBlock Text="{DynamicResource GrassCareerUseCachedLegacyLabel}"
                     TextWrapping="Wrap" />
        </CheckBox>
        <CheckBox Margin="0,10,0,0"
                  IsChecked="{Binding UseLegacyGuest}">
          <TextBlock Text="{DynamicResource GrassCareerUseLegacyGuestLabel}"
                     TextWrapping="Wrap" />
        </CheckBox>
      </StackPanel>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            IsEnabled="{Binding IsManualLegacySelection}">
      <StackPanel>
        <TextBlock Text="{DynamicResource GrassCareerAttributeSparksLabel}"
                   Style="{DynamicResource SettingCardTitleStyle}" />
        <ItemsControl Margin="0,8,0,0"
                      ItemsSource="{Binding AttributeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,10,0,0"
                   Text="{DynamicResource GrassCareerAptitudeSparksLabel}"
                   Style="{DynamicResource SettingCardTitleStyle}" />
        <ItemsControl Margin="0,8,0,0"
                      ItemsSource="{Binding AptitudeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
