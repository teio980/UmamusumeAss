<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.StartGameTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <Border Padding="12"
          Background="{DynamicResource SurfaceRaisedBrush}"
          BorderBrush="{DynamicResource BorderSubtleBrush}"
          BorderThickness="1"
          CornerRadius="6">
    <StackPanel>
      <TextBlock Text="{DynamicResource GrassGameLaunchTitle}"
                 FontWeight="Medium" />
      <TextBlock Margin="0,6,0,0"
                 Text="{DynamicResource GrassGamePackageHint}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
      <ui:TextBox Margin="0,10,0,0"
                  Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,8,0,0"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
    </StackPanel>
  </Border>
</UserControl>
