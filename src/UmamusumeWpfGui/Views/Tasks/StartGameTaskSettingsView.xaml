<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.StartGameTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <StackPanel TextElement.FontSize="12"
              Style="{DynamicResource SettingCardGroupStyle}">
    <TextBlock Text="{DynamicResource GrassGameLaunchTitle}"
               Style="{DynamicResource SettingGroupTitleStyle}" />
    <Border Style="{DynamicResource SettingCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0"
                       Symbol="Play24"
                       Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{DynamicResource GrassGamePackageLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <TextBlock Text="{DynamicResource GrassGamePackageHint}"
                     Style="{DynamicResource SettingCardDescriptionStyle}" />
          <ui:TextBox Margin="0,10,0,0"
                      Text="{Binding PackageId, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0"
                       Symbol="AppFolder24"
                       Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{DynamicResource GrassGameActivityLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <TextBlock Text="{DynamicResource GrassGameActivityHint}"
                     Style="{DynamicResource SettingCardDescriptionStyle}" />
          <ui:TextBox Margin="0,10,0,0"
                      Text="{Binding ActivityName, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}">
      <StackPanel>
        <TextBlock Text="{DynamicResource GrassTaskStatusLabel}"
                   Style="{DynamicResource SettingCardTitleStyle}" />
        <TextBlock Text="{Binding Status}"
                   Style="{DynamicResource SettingCardDescriptionStyle}" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
