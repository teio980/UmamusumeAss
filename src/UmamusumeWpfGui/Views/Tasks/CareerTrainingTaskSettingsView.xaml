<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.CareerTrainingTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <StackPanel>
      <TextBlock Text="Career Training Settings" FontWeight="Medium" />
      <TextBlock Margin="0,12,0,0" Text="Scenario manifest" />
      <ui:TextBox Margin="0,6,0,0"
                  Text="{Binding ManifestPath, UpdateSourceTrigger=PropertyChanged}" />
      <TextBlock Margin="0,12,0,0" Text="Trainee" />
      <taskviews:TraineePickerView Margin="0,6,0,0" />

      <TextBlock Margin="0,12,0,0" Text="Legacy selection" />
      <ComboBox Margin="0,6,0,0"
                ItemsSource="{Binding LegacySelectionModes}"
                DisplayMemberPath="Label"
                SelectedValuePath="Value"
                SelectedValue="{Binding LegacySelectionMode, UpdateSourceTrigger=PropertyChanged}" />
      <CheckBox Margin="0,8,0,0"
                IsChecked="{Binding UseLegacyGuest}">
        <TextBlock Text="Use a guest legacy for Legacy 1"
                   TextWrapping="Wrap" />
      </CheckBox>
      <StackPanel Margin="0,8,0,0"
                  IsEnabled="{Binding IsManualLegacySelection}">
        <TextBlock Text="Attribute sparks" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AttributeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,4,0,0" Text="Aptitude sparks" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AptitudeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <TextBlock Margin="0,12,0,0" Text="Support card IDs (optional)" />
      <ui:TextBox Margin="0,6,0,0"
                  Text="{Binding SupportCardIdsText, UpdateSourceTrigger=PropertyChanged}" />

      <TextBlock Margin="0,12,0,0" Text="Strategy ID" />
      <ui:TextBox Margin="0,6,0,0"
                  Text="{Binding StrategyId, UpdateSourceTrigger=PropertyChanged}" />

      <CheckBox Margin="0,12,0,0"
                IsChecked="{Binding PauseOnUnknownOutcome}">
        <TextBlock Text="Pause on unknown screen/outcome"
                   TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox Margin="0,8,0,0"
                IsChecked="{Binding AllowOptionalRaces}">
        <TextBlock Text="Allow optional races"
                   TextWrapping="Wrap" />
      </CheckBox>
      <TextBlock Margin="0,10,0,0"
                 Text="{Binding Status}"
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource TextSecondaryBrush}" />
  </StackPanel>
</UserControl>
