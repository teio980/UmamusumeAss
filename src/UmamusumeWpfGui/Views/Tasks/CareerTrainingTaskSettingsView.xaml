<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.CareerTrainingTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <DataTemplate x:Key="ComboOptionTemplate">
      <TextBlock Text="{Binding Label}"
                 TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>
  <TabControl TextElement.FontSize="12">
    <TabItem Header="Basic">
      <StackPanel Margin="8,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Trainee" />
          <taskviews:TraineePickerView Grid.Column="1" Margin="10,0,0,0" />
        </Grid>

        <CheckBox Margin="0,12,0,0"
                  IsChecked="{Binding ContinueExistingCareer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
          <StackPanel>
            <TextBlock Text="Continue existing Career" TextWrapping="Wrap" />
            <TextBlock Margin="0,2,0,0"
                       Text="If unavailable, delete Career data and start fresh."
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
          </StackPanel>
        </CheckBox>

        <Grid Margin="0,14,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Career mode" />
          <ComboBox Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding CareerModes}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding CareerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <Expander Margin="0,14,0,0"
                  Header="Independent Training (auto) · Train settings"
                  IsExpanded="True"
                  Visibility="{Binding IsIndependentCareer, Converter={StaticResource BoolToVisibility}}">
          <StackPanel Margin="8,10">
          <TextBlock Margin="0,0,0,10"
                     Text="These settings are applied by the Independent Training auto setup."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <TextBlock Text="Line Up Detail · strategy" />
          <ComboBox Margin="0,6,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding IndependentLineupStrategyOptions}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding IndependentLineupStrategy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,10,0,0" Text="Training Focus" />
          <ComboBox Margin="0,6,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding IndependentTrainingFocusOptions}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding IndependentTrainingFocus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Agenda · choose a time slot and race" />
            <ui:Button Grid.Column="1"
                       Margin="8,0,0,0"
                       Padding="10,3"
                       Content="Reset"
                       Command="{Binding ResetIndependentAgendaCommand}"
                       Appearance="Secondary" />
          </Grid>
          <ui:TextBox Margin="0,6,0,0"
                      PlaceholderText="Search race, year, month or surface"
                      Text="{Binding IndependentAgendaSearchText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding SelectedIndependentAgendaCountText}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <ListBox Height="190"
                   Margin="0,6,0,0"
                   BorderThickness="1"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   ItemsSource="{Binding FilteredIndependentRaceOptions}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="4,3"
                          HorizontalContentAlignment="Stretch"
                          IsEnabled="{Binding IsExecutable}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <Grid HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="74" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Grid.Column="0"
                           Width="68"
                           Height="34"
                           Margin="0,0,8,0"
                           HorizontalAlignment="Left"
                           Source="{Binding RaceCardImagePath}"
                           Stretch="UniformToFill"
                           Visibility="{Binding HasRaceCardImage, Converter={StaticResource BoolToVisibility}}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                      <TextBlock Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="{Binding CardMatchHint}"
                                 TextWrapping="Wrap"
                                 Visibility="{Binding HasRaceCardImage, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                  </Grid>
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="Skill · Add Skill" />
            <ui:Button Grid.Column="1"
                       Margin="8,0,0,0"
                       Padding="10,3"
                       Content="Reset"
                       Command="{Binding ResetIndependentSkillsCommand}"
                       Appearance="Secondary" />
          </Grid>
          <ui:TextBox Margin="0,6,0,0"
                      PlaceholderText="Search skill name or ID"
                      Text="{Binding IndependentSkillSearchText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Margin="0,4,0,0"
                     Text="{Binding SelectedIndependentSkillCountText}"
                     Foreground="{DynamicResource TextSecondaryBrush}" />
          <ListBox Height="190"
                   Margin="0,6,0,0"
                   BorderThickness="1"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.CanContentScroll="True"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True"
                   VirtualizingPanel.VirtualizationMode="Recycling"
                   ItemsSource="{Binding FilteredIndependentSkillOptions}">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <CheckBox Margin="4,3"
                          HorizontalContentAlignment="Stretch"
                          IsEnabled="{Binding IsExecutable}"
                          IsChecked="{Binding IsSelected, Mode=TwoWay}">
                  <TextBlock HorizontalAlignment="Stretch"
                             Text="{Binding Label}"
                             TextWrapping="Wrap" />
                </CheckBox>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          </StackPanel>
        </Expander>
      </StackPanel>
    </TabItem>

    <TabItem Header="Legacy">
      <StackPanel Margin="8,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Legacy selection" />
          <ComboBox Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding LegacySelectionModes}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding LegacySelectionMode, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      <CheckBox Margin="0,8,0,0"
                IsChecked="{Binding UseCachedLegacy}">
        <TextBlock Text="Use cached Legacy 1 and Legacy 2 records when available"
                   TextWrapping="Wrap" />
      </CheckBox>
      <CheckBox Margin="0,8,0,0"
                IsChecked="{Binding UseLegacyGuest}">
        <TextBlock Text="Use a guest legacy for Legacy 1"
                   TextWrapping="Wrap" />
      </CheckBox>
      <StackPanel Margin="0,8,0,0"
                  IsEnabled="{Binding IsManualLegacySelection}">
        <TextBlock Text="Attribute sparks" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AttributeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Margin="0,4,0,0" Text="Aptitude sparks" />
        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding AptitudeSparkOptions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox Margin="0,0,12,4"
                        Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
      </StackPanel>
    </TabItem>

    <TabItem Header="Cards">
      <StackPanel Margin="8,10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="108" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Support deck mode" />
          <ComboBox Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding SupportDeckModes}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding SupportDeckMode, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>
      <StackPanel Margin="0,8,0,0"
                  IsEnabled="{Binding IsSupportPresetMode}">
        <TextBlock Text="Support deck preset" />
        <ComboBox Margin="0,6,0,0"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding SupportDeckPresets}"
                  ItemTemplate="{StaticResource ComboOptionTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding SupportDeckPreset, UpdateSourceTrigger=PropertyChanged}" />
        <Expander Margin="0,10,0,0"
                  Header="{Binding FriendSupportCardDrawerHeader}"
                  IsExpanded="False"
                  IsEnabled="{Binding IsFriendSupportCardSettingEnabled}">
          <StackPanel Margin="6,6,0,0">
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding SelectedFriendSupportCardCountText}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel Margin="0,6,0,0">
              <ui:TextBox Text="{Binding FriendSupportCardSearchText, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Search name or ID" />
              <ComboBox Margin="0,6,0,0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding SupportCardTypeOptions}"
                        ItemTemplate="{StaticResource ComboOptionTemplate}"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding FriendSupportCardTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <ListBox Height="150"
                     Margin="0,6,0,0"
                     BorderThickness="1"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch"
                     ItemsSource="{Binding FilteredFriendSupportCardOptions}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="58" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.RowSpan="2"
                              Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <Image Grid.RowSpan="2"
                           Grid.Column="1"
                           Width="36"
                           Height="46"
                           Source="{Binding ImageUrl}"
                           Stretch="UniformToFill" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Margin="8,4,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding Label}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Margin="8,0,4,4"
                               VerticalAlignment="Center"
                               Text="{Binding Type}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Expander>
        <Expander Margin="0,8,0,0"
                  Header="{Binding SupportCardDrawerHeader}"
                  IsExpanded="False"
                  IsEnabled="{Binding IsManualSupportDeck}">
          <StackPanel Margin="6,6,0,0">
            <TextBlock Margin="0,0,0,6"
                       Text="{Binding SelectedSupportCardCountText}"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <StackPanel>
              <ui:TextBox Text="{Binding SupportCardSearchText, UpdateSourceTrigger=PropertyChanged}"
                          PlaceholderText="Search name or ID" />
              <ComboBox Margin="0,6,0,0"
                        HorizontalContentAlignment="Stretch"
                        ItemsSource="{Binding SupportCardTypeOptions}"
                        ItemTemplate="{StaticResource ComboOptionTemplate}"
                        SelectedValuePath="Value"
                        SelectedValue="{Binding SupportCardTypeFilter, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
            <ListBox Height="150"
                     Margin="0,6,0,0"
                     BorderThickness="1"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     HorizontalContentAlignment="Stretch"
                     ItemsSource="{Binding FilteredSupportCardOptions}">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Padding" Value="0" />
                  <Setter Property="Margin" Value="0" />
                </Style>
              </ListBox.ItemContainerStyle>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid MinHeight="58" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="30" />
                      <ColumnDefinition Width="40" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CheckBox Grid.RowSpan="2"
                              Grid.Column="0"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                    <Image Grid.RowSpan="2"
                           Grid.Column="1"
                           Width="36"
                           Height="46"
                           Source="{Binding ImageUrl}"
                           Stretch="UniformToFill" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Margin="8,4,4,0"
                               VerticalAlignment="Center"
                               Text="{Binding Label}"
                               TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Margin="8,0,4,4"
                               VerticalAlignment="Center"
                               Text="{Binding Type}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Margin="0,8,0,0" Text="Manual card IDs (optional; comma-separated)" />
            <ui:TextBox Margin="0,6,0,0"
                        Text="{Binding SupportCardIdsText, UpdateSourceTrigger=PropertyChanged}" />
          </StackPanel>
        </Expander>
      </StackPanel>
      </StackPanel>
    </TabItem>

  </TabControl>
</UserControl>
