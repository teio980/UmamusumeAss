<UserControl x:Class="UmamusumeWpfGui.Views.Tasks.CareerBasicSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <DataTemplate x:Key="ComboOptionTemplate">
      <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
    </DataTemplate>
  </UserControl.Resources>
  <StackPanel TextElement.FontSize="12"
              HorizontalAlignment="Stretch">
    <Border Style="{DynamicResource SettingCardStyle}"
            HorizontalAlignment="Stretch">
      <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0"
                       Symbol="Person24"
                       Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Stretch">
          <TextBlock Text="{DynamicResource GrassCareerTraineeLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <taskviews:TraineePickerView Margin="0,10,0,0"
                                       HorizontalAlignment="Stretch"
                                       DataContext="{Binding Entry}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            HorizontalAlignment="Stretch">
      <CheckBox IsChecked="{Binding DeleteExistingCareerData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
        <StackPanel>
          <TextBlock Text="{DynamicResource GrassCareerDeleteExistingLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <TextBlock Text="{DynamicResource GrassCareerDeleteExistingHint}"
                     Style="{DynamicResource SettingCardDescriptionStyle}" />
        </StackPanel>
      </CheckBox>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            HorizontalAlignment="Stretch">
      <Grid HorizontalAlignment="Stretch">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ui:SymbolIcon Grid.Column="0"
                       Symbol="AppsList24"
                       Style="{DynamicResource SettingIconStyle}" />
        <StackPanel Grid.Column="1"
                    HorizontalAlignment="Stretch">
          <TextBlock Text="{DynamicResource GrassCareerModeLabel}"
                     Style="{DynamicResource SettingCardTitleStyle}" />
          <ComboBox Margin="0,10,0,0"
                    HorizontalContentAlignment="Stretch"
                    ItemsSource="{Binding CareerModes}"
                    ItemTemplate="{StaticResource ComboOptionTemplate}"
                    SelectedValuePath="Value"
                    SelectedValue="{Binding CareerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Style="{DynamicResource SettingCardStyle}"
            HorizontalAlignment="Stretch"
            Visibility="{Binding IsNormalCareer, Converter={StaticResource BoolToVisibility}}">
      <StackPanel>
        <TextBlock Text="{DynamicResource GrassNormalLineupStrategyLabel}"
                   Style="{DynamicResource SettingCardTitleStyle}" />
        <ComboBox Margin="0,10,0,0"
                  HorizontalContentAlignment="Stretch"
                  ItemsSource="{Binding NormalLineupStrategyOptions}"
                  ItemTemplate="{StaticResource ComboOptionTemplate}"
                  SelectedValuePath="Value"
                  SelectedValue="{Binding NormalLineupStrategy, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
      </StackPanel>
    </Border>
    <taskviews:IndependentTrainingSettingsView DataContext="{Binding Independent}" />
  </StackPanel>
</UserControl>
