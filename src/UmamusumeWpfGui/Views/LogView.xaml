<UserControl x:Class="UmamusumeWpfGui.Views.LogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UmamusumeWpfGui.Converters"
             xmlns:m="clr-namespace:UmamusumeWpfGui.Models"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextPrimaryBrush}">
  <UserControl.Resources>
    <c:LogEntryKindToColorConverter x:Key="LogColorConverter" />
    <c:CountToVisibilityConverter x:Key="CountToVisibility" />
    <Style x:Key="LogPanelStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource SurfacePanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="42">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <TextBlock Text="{DynamicResource TabLog}"
               FontSize="20"
               FontWeight="Medium" />

    <Border Grid.Row="1"
            Margin="0,12,0,0"
            Padding="14"
            Style="{StaticResource LogPanelStyle}">
      <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="{DynamicResource GrassLogs}"
                     FontWeight="SemiBold" />
          <StackPanel Grid.Column="1"
                      HorizontalAlignment="Right"
                      Orientation="Horizontal">
            <ui:Button Content="{DynamicResource GrassCopyLog}"
                       Appearance="Secondary"
                       Icon="Copy24"
                       Click="OnCopyAllClick" />
            <ui:Button Margin="6,0,0,0"
                       Content="{DynamicResource GrassClearLog}"
                       Appearance="Secondary"
                       Icon="Delete24"
                       Click="OnClearAllClick" />
          </StackPanel>
        </Grid>

        <Grid>
          <ListBox x:Name="EntriesListBox"
                   ItemsSource="{Binding Entries}"
                   BorderThickness="0"
                   Background="Transparent"
                   HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="{x:Type m:LogEntry}">
                <Border Margin="0,0,0,6"
                        Padding="0,7,8,7"
                        Background="{DynamicResource SurfaceRaisedBrush}"
                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        ToolTip="{Binding Details}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4" />
                      <ColumnDefinition Width="72" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Margin="0,0,8,0"
                            Background="{Binding Kind, Converter={StaticResource LogColorConverter}}"
                            CornerRadius="2" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Timestamp, StringFormat={}{0:HH:mm:ss.fff}}"
                                 FontSize="10"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                      <TextBlock Margin="0,3,0,0"
                                 Text="{Binding Kind}"
                                 FontSize="10"
                                 FontWeight="SemiBold"
                                 Foreground="{Binding Kind, Converter={StaticResource LogColorConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                      <TextBlock Text="{Binding Type}"
                                 FontSize="11"
                                 FontWeight="SemiBold"
                                 TextWrapping="Wrap" />
                      <TextBlock Margin="0,3,0,0"
                                 Text="{Binding Details}"
                                 FontSize="11"
                                 LineHeight="16"
                                 TextWrapping="Wrap"
                                 Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{DynamicResource LogEmptyMessage}"
                     FontStyle="Italic"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Visibility="{Binding Entries.Count,
                         Converter={StaticResource CountToVisibility}}"
                     IsHitTestVisible="False" />
        </Grid>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>
