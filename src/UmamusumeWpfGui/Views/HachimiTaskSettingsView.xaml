<UserControl x:Class="UmamusumeWpfGui.Views.HachimiTaskSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:UmamusumeWpfGui.Converters"
             xmlns:tasksettings="clr-namespace:UmamusumeWpfGui.ViewModels.Tasks"
             xmlns:taskviews="clr-namespace:UmamusumeWpfGui.Views.Tasks"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Foreground="{DynamicResource TextFillColorPrimaryBrush}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <c:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- SettingCardGroupStyle, SettingCardStyle, and the SettingsTab styles
         are shared application resources with SettingsView. -->
    <DataTemplate DataType="{x:Type tasksettings:StartGameTaskSettingsViewModel}">
      <taskviews:StartGameTaskSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tasksettings:TeamRaceTaskSettingsViewModel}">
      <taskviews:TeamRaceTaskSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tasksettings:DailyRaceTaskSettingsViewModel}">
      <taskviews:DailyRaceTaskSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tasksettings:CareerTrainingTaskSettingsViewModel}">
      <taskviews:CareerTrainingTaskSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tasksettings:MailCollectionTaskSettingsViewModel}">
      <taskviews:MailCollectionTaskSettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type tasksettings:MissionCollectionTaskSettingsViewModel}">
      <taskviews:MissionCollectionTaskSettingsView />
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer HorizontalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,24,42,42"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                TextElement.FontSize="12">
      <Grid Margin="0,0,0,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="{DynamicResource GrassTaskSettingsPageTitle}"
                     FontSize="32"
                     FontWeight="Light" />
          <TextBlock Margin="0,6,0,0"
                     Text="{Binding SelectedTask.Name}"
                     FontSize="16"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />
        </StackPanel>
        <ui:Button Grid.Column="1"
                   MinWidth="88"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   Content="{DynamicResource GrassTaskSettingsBack}"
                   Appearance="Secondary"
                   Click="OnBackClick" />
      </Grid>

      <TextBlock Margin="0,0,0,22"
                 Text="{Binding SelectedTask.Description}"
                 Style="{DynamicResource SettingCardDescriptionStyle}" />

      <!-- Simple task editors render their own SettingCard groups. Career's
           Basic/Legacy/Cards Pivot is the sole task-level navigation. -->
      <ContentControl Content="{Binding SelectedTask.Settings}"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Visibility="{Binding IsSelectedShopTask,
                                           Converter={StaticResource InverseBoolToVisibility}}" />
      <StackPanel Visibility="{Binding IsSelectedShopTask,
                                        Converter={StaticResource BoolToVisibility}}"
                  Style="{DynamicResource SettingCardGroupStyle}">
        <Border Style="{DynamicResource SettingCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon Grid.Column="0"
                           Symbol="Settings24"
                           Style="{DynamicResource SettingIconStyle}" />
            <StackPanel Grid.Column="1">
              <TextBlock Text="{DynamicResource GrassShopSettingsTitle}"
                         Style="{DynamicResource SettingCardTitleStyle}" />
              <TextBlock Margin="0,4,0,0"
                         Text="{DynamicResource GrassShopSettingsLocationHint}"
                         Style="{DynamicResource SettingCardDescriptionStyle}" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="2"
                             VerticalAlignment="Center"
                             IsChecked="{Binding HachimiShopSettings.Enabled, Mode=TwoWay}"
                             OnContent="{DynamicResource ToggleOn}"
                             OffContent="{DynamicResource ToggleOff}" />
          </Grid>
        </Border>
        <Border Style="{DynamicResource SettingCardStyle}">
          <StackPanel>
            <TextBlock Text="{DynamicResource GrassShopSelectAll}"
                       Style="{DynamicResource SettingCardTitleStyle}" />
            <TextBlock Margin="0,4,0,10"
                       Text="{DynamicResource GrassShopSelectAllHint}"
                       Style="{DynamicResource SettingCardDescriptionStyle}" />
            <ui:ToggleSwitch IsChecked="{Binding HachimiShopSettings.SelectAll, Mode=TwoWay}"
                             OnContent="{DynamicResource ToggleOn}"
                             OffContent="{DynamicResource ToggleOff}" />
          </StackPanel>
        </Border>
        <Border Style="{DynamicResource SettingCardStyle}">
          <StackPanel>
            <TextBlock Text="{DynamicResource GrassShopItemsTitle}"
                       Style="{DynamicResource SettingCardTitleStyle}" />
            <CheckBox Margin="0,12,0,0"
                      Content="{DynamicResource GrassShopBuyStarPieces}"
                      IsChecked="{Binding HachimiShopSettings.BuyStarPieces, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="{DynamicResource GrassShopBuyAlarmClock}"
                      IsChecked="{Binding HachimiShopSettings.BuyAlarmClock, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="{DynamicResource GrassShopBuyPleasingParfait}"
                      IsChecked="{Binding HachimiShopSettings.BuyPleasingParfait, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="{DynamicResource GrassShopBuyShoes}"
                      IsChecked="{Binding HachimiShopSettings.BuyShoes, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="{DynamicResource GrassShopBuySupportPoints}"
                      IsChecked="{Binding HachimiShopSettings.BuySupportPoints, Mode=TwoWay}" />
            <CheckBox Margin="0,8,0,0"
                      Content="{DynamicResource GrassShopBuyFlags}"
                      IsChecked="{Binding HachimiShopSettings.BuyFlags, Mode=TwoWay}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
