<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">







  <SolidColorBrush x:Key="SurfaceCanvasBrush" Color="#F4F7FB" />
  <SolidColorBrush x:Key="SurfaceSidebarBrush" Color="#F8FAFD" />
  <SolidColorBrush x:Key="SurfacePanelBrush" Color="#FFFFFF" />
  <SolidColorBrush x:Key="SurfaceRaisedBrush" Color="#F9FBFE" />
  <SolidColorBrush x:Key="SidebarHoverBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="SidebarSelectedBrush" Color="{DynamicResource SystemAccentColorTertiary}" />
  <SolidColorBrush x:Key="SidebarPressedBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
  <DropShadowEffect x:Key="SidebarIndicatorGlowEffect"
                    Color="{DynamicResource SystemAccentColorPrimary}"
                    BlurRadius="8"
                    ShadowDepth="0"
                    Opacity="0.85" />


  <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1D2533" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7687" />
  <SolidColorBrush x:Key="TextDisabledBrush" Color="#A3ADBA" />


  <SolidColorBrush x:Key="BorderDefaultBrush" Color="#DDE4EE" />
  <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E9EEF5" />


  <SolidColorBrush x:Key="AccentPrimaryBrush" Color="{DynamicResource SystemAccentColorPrimary}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource SystemAccentColorSecondary}" />


  <SolidColorBrush x:Key="StatusSuccessBrush" Color="#317B62" />
  <SolidColorBrush x:Key="StatusWarningBrush" Color="#A86F23" />
  <SolidColorBrush x:Key="StatusErrorBrush" Color="#B84B58" />
  <SolidColorBrush x:Key="StatusInfoBrush" Color="#4D739B" />

</ResourceDictionary>
