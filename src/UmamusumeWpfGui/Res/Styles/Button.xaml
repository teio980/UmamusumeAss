<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">


  <Style x:Key="PrimaryButtonStyle" TargetType="{x:Type ui:Button}">
    <Setter Property="Height" Value="34" />
    <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="Border.CornerRadius" Value="4" />
    <Setter Property="Appearance" Value="Primary" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type ui:Button}">
    <Setter Property="Border.CornerRadius" Value="4" />
    <Setter Property="Appearance" Value="Secondary" />
  </Style>
</ResourceDictionary>
