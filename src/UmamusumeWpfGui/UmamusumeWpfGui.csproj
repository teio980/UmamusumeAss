<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UmamusumeAss</AssemblyName>
    <RootNamespace>UmamusumeWpfGui</RootNamespace>
    <ApplicationIcon>Assets\teio-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stylet" Version="1.3.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <FrameworkReference Include="Microsoft.Windows.SDK.NET.Ref" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umamusume.CoreBridge\Umamusume.CoreBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\teio-logo.ico" />
    <Resource Include="Assets\teio-logo.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\CMakeLists.txt" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\CMakePresets.json" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\version.txt" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\cmake\**\*.cmake" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\include\**\*.h;$(MSBuildProjectDirectory)\..\..\include\**\*.hpp" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\src\UmaAssistantCore\**\*.cpp;$(MSBuildProjectDirectory)\..\..\src\UmaAssistantCore\**\*.h;$(MSBuildProjectDirectory)\..\..\src\UmaAssistantCore\**\*.hpp" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\src\UmamusumeAssUpdater\**\*.cpp;$(MSBuildProjectDirectory)\..\..\src\UmamusumeAssUpdater\**\*.h;$(MSBuildProjectDirectory)\..\..\src\UmamusumeAssUpdater\CMakeLists.txt" />
    <UpToDateCheckInput Include="$(MSBuildProjectDirectory)\..\..\tools\CMakeLists.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resource\connection.json"
             Link="resource\connection.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\hachimi\**\*"
             Exclude="..\..\resource\hachimi\debug\**\*"
             Link="resource\hachimi\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\database\global\**\*"
             Link="resource\uma\database\global\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\career_filter_tab.png"
             Link="resource\uma\career_filter_tab.png"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\assets\images\global\trainees\**\*"
             Link="resource\uma\assets\images\global\trainees\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\assets\images\global\live_outfits\**\*"
             Link="resource\uma\assets\images\global\live_outfits\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\assets\templates\global\support_cards\**\*"
             Link="resource\uma\assets\templates\global\support_cards\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\system_reference\**\*"
             Link="resource\uma\system_reference\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildAndCopyNativeRuntimeForDebug"
          AfterTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <RepositoryRoot>$(MSBuildProjectDirectory)\..\..</RepositoryRoot>
      <NativeStagingDirectory>$(MSBuildProjectDirectory)\..\..\build\native-staging</NativeStagingDirectory>
    </PropertyGroup>
    <Exec Command="cmake --preset release"
          WorkingDirectory="$(RepositoryRoot)"
          Condition="!Exists('$(RepositoryRoot)\build\release\CMakeCache.txt')" />
    <Exec Command="cmake --build build\release --config Release --target UmaAssistantCore UmamusumeAss.Updater --parallel"
          WorkingDirectory="$(RepositoryRoot)" />
    <Exec Command="cmake --install build\release --prefix build\native-staging --config Release"
          WorkingDirectory="$(RepositoryRoot)" />
    <Copy SourceFiles="$(NativeStagingDirectory)\UmamusumeCore.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeStagingDirectory)\UmamusumeCore.dll')" />
    <Copy SourceFiles="$(NativeStagingDirectory)\UmamusumeAss.Updater.exe"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(NativeStagingDirectory)\UmamusumeAss.Updater.exe')" />
    <Copy SourceFiles="$(RepositoryRoot)\version.txt"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
    <Warning Text="Native DLL was not found in '$(NativeStagingDirectory)' after the automatic CMake build and install."
             Condition="!Exists('$(NativeStagingDirectory)\UmamusumeCore.dll')" />
  </Target>

</Project>
