<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <AssemblyName>UmamusumeAss</AssemblyName>
    <RootNamespace>UmamusumeWpfGui</RootNamespace>
    <ApplicationIcon>Assets\teio-logo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stylet" Version="1.3.7" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Umamusume.CoreBridge\Umamusume.CoreBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\teio-logo.ico" />
    <Resource Include="Assets\teio-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\resource\connection.json"
             Link="resource\connection.json"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\hachimi\**\*"
             Exclude="..\..\resource\hachimi\debug\**\*"
             Link="resource\hachimi\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\database\global\**\*"
             Link="resource\uma\database\global\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\assets\images\global\trainees\**\*"
             Link="resource\uma\assets\images\global\trainees\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\assets\images\global\uniforms\**\*"
             Link="resource\uma\assets\images\global\uniforms\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\resource\uma\system_reference\**\*"
             Link="resource\uma\system_reference\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
