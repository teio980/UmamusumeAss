<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umamusume.Avalonia.ViewModels"
             xmlns:svc="using:Umamusume.Avalonia.Services"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Umamusume.Avalonia.Views.Pages.DeveloperToolsPage"
             x:DataType="vm:DeveloperToolsViewModel">
  <Grid RowDefinitions="Auto,*" Margin="32,28,32,24">
    <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
            CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Text="{DynamicResource Ui_ac1367cb8fbf}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
        <TextBlock Grid.Column="1" Text="{Binding ResourceStatusText}" VerticalAlignment="Center"
                   FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="12,0" />
        <Button Grid.Column="2" Command="{Binding ReloadNativeResourcesCommand}" Padding="12,7" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <ui:SymbolIcon Symbol="Refresh" FontSize="14" VerticalAlignment="Center" />
            <TextBlock Text="{DynamicResource Ui_27bce1339e25}" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <TabControl Grid.Row="1">
      <TabItem Header="{DynamicResource Ui_bd18d9a65f17}">
        <Grid RowDefinitions="Auto,*" ColumnDefinitions="2*,*" Margin="6,14,6,0">
          <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10" Margin="0,0,0,12">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto">
              <Button Command="{Binding CaptureScreenshotCommand}" IsEnabled="{Binding IsConnected}" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Camera" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Ui_f72990bec4d2}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Grid.Column="1" Click="OnImportScreenshotClick" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><ui:SymbolIcon Symbol="OpenFile" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Ui_0d355ab7b4bc}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Grid.Column="2" Click="OnExportScreenshotClick" IsEnabled="{Binding HasScreenshot}" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Save" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Ui_30e7d4f32896}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <Button Grid.Column="3" Click="OnSaveCropClick" IsEnabled="{Binding HasCropRegion}" Padding="12,7" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center"><ui:SymbolIcon Symbol="Crop" VerticalAlignment="Center" /><TextBlock Text="{DynamicResource Ui_fd20f53478e2}" VerticalAlignment="Center" /></StackPanel>
              </Button>
              <TextBlock Grid.Column="4" Text="{Binding ScreenshotInfoText}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" />
              <Button Grid.Column="5" Command="{Binding ClearCropCommand}" IsEnabled="{Binding HasCropRegion}"
                      Content="{DynamicResource Ui_9f961bf6877e}" Padding="10,6" VerticalAlignment="Center" />
            </Grid>
          </Border>

          <Border Grid.Row="1" Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Margin="0,0,12,0" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding ScreenshotBitmap}" Stretch="Uniform" Margin="8"
                     HorizontalAlignment="Center" VerticalAlignment="Center" />
              <StackPanel IsVisible="{Binding !HasScreenshot}" HorizontalAlignment="Center"
                          VerticalAlignment="Center" Spacing="8">
                <ui:SymbolIcon Symbol="Camera" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                <TextBlock Text="{DynamicResource Ui_9180b10219b3}" FontSize="14" HorizontalAlignment="Center" TextWrapping="Wrap" />
              </StackPanel>
              <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                      Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                      BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                      CornerRadius="5" Padding="8,4" IsVisible="{Binding HasCropRegion}">
                <TextBlock Text="{Binding CropRegionText}" FontSize="11" />
              </Border>
              <Canvas x:Name="ScreenshotCanvas" Background="#01000000"
                      PointerPressed="OnScreenshotPointerPressed"
                      PointerMoved="OnScreenshotPointerMoved"
                      PointerReleased="OnScreenshotPointerReleased">
                <Border x:Name="CropSelection" Width="0" Height="0" IsHitTestVisible="False"
                        IsVisible="{Binding HasCropRegion}"
                        BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2"
                        Background="#263B82F6" />
              </Canvas>
            </Panel>
          </Border>

          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14">
            <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
              <TextBlock Text="{DynamicResource Ui_2a9b1f950ccc}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
              <Grid Grid.Row="1" ColumnDefinitions="*,150">
                <ListBox ItemsSource="{Binding TemplateImages}" SelectedItem="{Binding SelectedTemplateImage}"
                         Background="{DynamicResource ControlFillColorDefaultBrush}">
                  <ListBox.ItemTemplate>
                    <DataTemplate DataType="svc:DeveloperResourceFile">
                      <TextBlock Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        CornerRadius="5" ClipToBounds="True">
                  <Image Source="{Binding TemplatePreviewBitmap}" Stretch="Uniform" Margin="6" />
                </Border>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding TemplatePath}" Watermark="{DynamicResource Ui_1f54702c37ae}" />
                <Button Grid.Column="1" Click="OnChooseTemplateClick" Content="{DynamicResource Ui_ef23ea67b002}" />
              </Grid>
              <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto,100,Auto">
                <TextBlock Text="{DynamicResource Ui_b77e2ac8f4d1}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableMatchMethods}" SelectedItem="{Binding MatchMethod}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{DynamicResource Ui_a05320e189cb}" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="3" Minimum="0" Maximum="1" Increment="0.01" Value="{Binding MatchThreshold}" VerticalAlignment="Center" />
                <Button Grid.Column="4" Command="{Binding MatchImageCommand}" IsEnabled="{Binding !IsMatchingImage}"
                        Content="{DynamicResource Ui_f941a68c1b1a}" Padding="10,6" VerticalAlignment="Center" />
              </Grid>
              <TextBlock Grid.Row="4" Text="{Binding ImageMatchStatus}" TextWrapping="Wrap" FontSize="12"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Ui_72e394b9863b}">
        <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" ColumnDefinitions="220,*" Margin="6,14,6,0">
          <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto">
            <ComboBox Grid.Column="0" ItemsSource="{Binding PipelineFiles}" SelectedItem="{Binding SelectedPipelineFile}">
              <ComboBox.ItemTemplate><DataTemplate DataType="svc:DeveloperResourceFile"><TextBlock Text="{Binding RelativePath}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Command="{Binding RefreshResourcesCommand}" Content="{DynamicResource Ui_38108eaa1d32}" />
            <Button Grid.Column="2" Command="{Binding NewPipelineCommand}" Content="{DynamicResource Ui_0cda8d1c7182}" />
            <Button Grid.Column="3" Click="OnOpenPipelineClick" Content="{DynamicResource Ui_38820b3dc3d7}" />
            <Button Grid.Column="4" Click="OnSavePipelineClick" Content="{DynamicResource Ui_fadf24dbc5a9}" />
            <Button Grid.Column="5" Command="{Binding ValidatePipelineCommand}" Content="{DynamicResource Ui_65b2d378fb5d}" />
          </Grid>
          <Border Grid.Row="1" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto,190,Auto,Auto,Auto,Auto,Auto">
              <TextBlock Text="{DynamicResource Ui_e840cd6f1e21}" VerticalAlignment="Center" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding PipelineTaskNames}" SelectedItem="{Binding SelectedPipelineTaskName}" VerticalAlignment="Center" />
              <Button Grid.Column="2" Command="{Binding AddPipelineTaskCommand}" Content="{DynamicResource Ui_94191ce210d3}" VerticalAlignment="Center" />
              <Button Grid.Column="3" Command="{Binding RemovePipelineTaskCommand}" Content="{DynamicResource Ui_f7920748264e}" VerticalAlignment="Center" />
              <Button Grid.Column="4" Command="{Binding UseCropAsPipelineRoiCommand}" Content="{DynamicResource Ui_2c662639f852}" VerticalAlignment="Center" />
              <Button Grid.Column="5" Command="{Binding SavePipelineTemplateCommand}" IsEnabled="{Binding CanSavePipelineTemplate}" Content="{Binding PipelineTemplateSaveLabel}" VerticalAlignment="Center" />
              <Button Grid.Column="6" Command="{Binding EditPipelineTemplateCommand}" IsEnabled="{Binding CanEditPipelineTemplate}" Content="{DynamicResource Ui_af5a5bd865cd}" VerticalAlignment="Center" />
              <Button Grid.Column="7" Command="{Binding UndoPipelineCommand}" IsEnabled="{Binding CanUndoPipeline}" Content="{DynamicResource Ui_9fcefd8dc81e}" VerticalAlignment="Center" />
              <Button Grid.Column="8" Command="{Binding RedoPipelineCommand}" IsEnabled="{Binding CanRedoPipeline}" Content="{DynamicResource Ui_1238f0d36361}" VerticalAlignment="Center" />
            </Grid>
          </Border>
          <Border Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
            <Grid ColumnDefinitions="Auto,*,Auto,220">
              <TextBlock Text="{DynamicResource Ui_095325d6a143}" VerticalAlignment="Center" Margin="0,0,8,0" />
              <TextBox Grid.Column="1" Text="{Binding PipelineEntryTask}" Watermark="{DynamicResource Ui_99402f75fa92}" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{DynamicResource Ui_a2273aee08de}" VerticalAlignment="Center" Margin="8,0" />
              <ComboBox Grid.Column="3" ItemsSource="{Binding TemplateDirectories}" SelectedItem="{Binding SelectedTemplateDirectory}" VerticalAlignment="Center">
                <ComboBox.ItemTemplate><DataTemplate DataType="svc:DeveloperResourceFile"><TextBlock Text="{Binding RelativePath}" VerticalAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Border>
          <Border Grid.Row="3" Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="10" Margin="0,0,0,0">
            <Grid RowDefinitions="Auto,*">
              <TextBlock Text="{DynamicResource Ui_d031bb3a348b}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <ScrollViewer Grid.Row="1">
                <TextBlock Text="{Binding PipelineGraphText}" FontFamily="Menlo, Monaco, Consolas, Courier New, monospace"
                           FontSize="11" TextWrapping="Wrap" />
              </ScrollViewer>
            </Grid>
          </Border>
          <Border Grid.Row="3" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
            <TextBox Text="{Binding PipelineJsonText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontSize="12"
                     FontFamily="Menlo, Monaco, Consolas, Courier New, monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Border>
          <TextBlock Grid.Row="4" Grid.ColumnSpan="2" Text="{Binding PipelineStatusText}" TextWrapping="Wrap" FontSize="12"
                     Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
          <Border Grid.Row="5" Grid.ColumnSpan="2" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="9">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="Auto,*,Auto,220,Auto,Auto,Auto">
                <TextBlock Text="{DynamicResource Ui_b6c61846bbeb}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding ReplayFixtures}" SelectedItem="{Binding SelectedReplayFixture}" VerticalAlignment="Center">
                  <ComboBox.ItemTemplate><DataTemplate DataType="svc:DeveloperResourceFile"><TextBlock Text="{Binding RelativePath}" VerticalAlignment="Center" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Button Grid.Column="2" Click="OnChooseReplayFixtureClick" Content="{DynamicResource Ui_ef23ea67b002}" VerticalAlignment="Center" />
                <Button Grid.Column="3" Command="{Binding PreviewPipelineCommand}" Content="{DynamicResource Ui_f17bfa9ad736}" VerticalAlignment="Center" />
                <Button Grid.Column="4" Command="{Binding RunPipelineCommand}" IsEnabled="{Binding CanRunPipeline}" Content="{DynamicResource Ui_c1f05b9d30e1}" VerticalAlignment="Center" />
                <Button Grid.Column="5" Command="{Binding RunOfflineReplayCommand}" IsEnabled="{Binding !IsPipelineRunning}" Content="{DynamicResource Ui_f2f0d04e0b72}" VerticalAlignment="Center" />
                <Button Grid.Column="6" Command="{Binding StopPipelineCommand}" IsEnabled="{Binding IsPipelineRunning}" Content="{DynamicResource Ui_a17f70a8d3d6}" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="*,*">
                <TextBlock Text="{Binding PipelineRunStatusText}" TextWrapping="Wrap" FontSize="12" />
                <TextBox Grid.Column="1" Text="{Binding ReplayOutputText}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="Wrap" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Ui_dabcd1432134}">
        <Grid RowDefinitions="Auto,*,Auto,*" ColumnDefinitions="260,*" Margin="6,14,6,0">
          <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto,Auto,Auto">
            <ComboBox ItemsSource="{Binding ScenarioManifests}" SelectedItem="{Binding SelectedScenarioManifest}">
              <ComboBox.ItemTemplate><DataTemplate DataType="svc:DeveloperResourceFile"><TextBlock Text="{Binding RelativePath}" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Click="OnOpenScenarioManifestClick" Content="{DynamicResource Ui_927d9db596c0}" />
            <Button Grid.Column="2" Command="{Binding RefreshResourcesCommand}" Content="{DynamicResource Ui_bf36576952eb}" />
            <Button Grid.Column="3" Command="{Binding ValidateScenarioPackageCommand}" IsEnabled="{Binding !IsScenarioBusy}" Content="{DynamicResource Ui_09a9e3c8b47c}" />
          </Grid>
          <Border Grid.Row="1" Grid.Column="0" Grid.RowSpan="3" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
            <ListBox ItemsSource="{Binding ScenarioPackageFiles}" SelectedItem="{Binding SelectedScenarioFile}"
                     Background="{DynamicResource ControlFillColorDefaultBrush}">
              <ListBox.ItemTemplate><DataTemplate DataType="svc:DeveloperResourceFile"><TextBlock Text="{Binding RelativePath}" FontSize="11" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="7" Padding="8">
            <TextBox Text="{Binding ScenarioJsonText, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" FontSize="12"
                     FontFamily="Menlo, Monaco, Consolas, Courier New, monospace" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </Border>
          <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Text="{Binding ScenarioStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" />
            <Button Grid.Column="1" Command="{Binding SaveScenarioFileCommand}" Content="{DynamicResource Ui_0dbfdf5ad341}" />
            <Button Grid.Column="2" Command="{Binding ValidateScenarioPackageCommand}" Content="{DynamicResource Ui_577775d3afd7}" />
          </Grid>
          <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ScenarioInspectionText}" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="{DynamicResource ControlFillColorDefaultBrush}" />
        </Grid>
      </TabItem>

      <TabItem Header="{DynamicResource Ui_a6541f651a0d}">
        <Grid ColumnDefinitions="340,*" Margin="6,14,6,0">
          <Border Grid.Column="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="10" Margin="0,0,12,0">
            <Grid RowDefinitions="Auto,*">
              <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <TextBox Text="{Binding UmaImageSearchText, UpdateSourceTrigger=PropertyChanged}" Watermark="{DynamicResource Ui_b0c6564d9483}" />
                <Button Grid.Column="1" Command="{Binding RefreshUmaDatabaseImagesCommand}" Content="{DynamicResource Ui_38108eaa1d32}" />
              </Grid>
              <ListBox Grid.Row="1" ItemsSource="{Binding FilteredUmaDatabaseImages}" SelectedItem="{Binding SelectedUmaImage}"
                       Background="{DynamicResource ControlFillColorDefaultBrush}">
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="svc:UmaDatabaseImageItem">
                    <Grid ColumnDefinitions="56,*" Margin="2,4">
                      <Border Width="48" Height="56" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                              CornerRadius="4" ClipToBounds="True">
                        <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="{Binding DisplayName}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ImagePath}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="14">
            <Grid RowDefinitions="*,Auto,Auto,Auto">
              <Border Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                      BorderThickness="1" CornerRadius="6" ClipToBounds="True" Padding="8">
                <Image Source="{Binding SelectedUmaImagePreviewBitmap}" Stretch="Uniform" />
              </Border>
              <StackPanel Grid.Row="1" Margin="0,10,0,6" Spacing="4">
                <TextBlock Text="{Binding SelectedUmaImage.DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedUmaImage.ReferencePath}" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding ScreenshotInfoText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="{Binding CropRegionText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
              </StackPanel>
              <Grid Grid.Row="2" ColumnDefinitions="*,*,*">
                <Button Command="{Binding UseSelectedUmaImageAsCropSourceCommand}" IsEnabled="{Binding HasSelectedUmaImage}"
                        Content="{DynamicResource Ui_38fba6de7101}" />
                <Button Grid.Column="1" Command="{Binding SaveSystemReferenceCommand}" IsEnabled="{Binding CanSaveSystemReference}"
                        Content="{DynamicResource Ui_6add104a3d97}" />
                <Button Grid.Column="2" Command="{Binding TestSystemReferenceMatchCommand}" IsEnabled="{Binding CanTestSystemReferenceMatch}"
                        Content="{DynamicResource Ui_c812227b6fba}" />
              </Grid>
              <TextBlock Grid.Row="3" Text="{Binding SystemReferenceStatus}" Margin="0,8,0,0" TextWrapping="Wrap"
                         FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
          </Border>
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</UserControl>
