<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Umamusume.Avalonia.ViewModels"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             x:Class="Umamusume.Avalonia.Views.Pages.ScreenOcrPage"
             x:DataType="vm:ScreenOcrViewModel">

    <Grid RowDefinitions="Auto,Auto,*" Margin="24,20,24,20">

        <!-- Top Command Bar: Fully responsive WrapPanel so items flow smoothly on any screen width -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Capture Button -->
                <Button Command="{Binding CaptureScreenshotCommand}"
                        IsEnabled="{Binding IsConnected}"
                        Classes="accent"
                        Padding="12,6" Margin="0,0,6,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Camera" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_514f0e57db47}" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Run OCR Button -->
                <Button Command="{Binding RunOcrCommand}"
                        IsEnabled="{Binding HasScreenshot}"
                        Padding="12,6" Margin="0,0,8,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Find" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_e8b09b937108}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Language Selector -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,4">
                    <TextBlock Text="{DynamicResource Ui_da27ac613471}" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                    <ComboBox ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding OcrLanguage}"
                              Width="80" Height="32" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Import Button -->
                <Button Click="OnImportScreenshotClick" Padding="10,6" Margin="0,0,6,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="OpenFile" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_0d355ab7b4bc}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Export Button -->
                <Button Click="OnExportScreenshotClick" IsEnabled="{Binding HasScreenshot}"
                        Padding="10,6" Margin="0,0,6,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Save" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_30e7d4f32896}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Save Crop Button -->
                <Button Click="OnSaveCropClick" IsEnabled="{Binding HasCropRegion}"
                        Padding="10,6" Margin="0,0,6,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Crop" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_fd20f53478e2}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Clear Button -->
                <Button Command="{Binding ClearAllCommand}"
                        Padding="10,6" Margin="0,0,10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Delete" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_7b15e5e8e7bd}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Metadata Indicators (Pill badge) -->
                <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                        CornerRadius="6" Padding="10,5" Margin="0,0,0,4" VerticalAlignment="Center"
                        IsVisible="{Binding HasScreenshot}">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui_896178794f39}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScreenshotDimensionsText}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="•" FontSize="10" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Ui_b6cd19b531a7}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScreenshotTimestampText}" FontSize="11" FontWeight="Medium"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Notification InfoBar -->
        <ui:InfoBar Grid.Row="1"
                    IsOpen="{Binding IsNotificationOpen}"
                    Title="{Binding NotificationTitle}"
                    Message="{Binding NotificationMessage}"
                    Severity="{Binding NotificationSeverity}"
                    IsClosable="True"
                    CloseButtonCommand="{Binding DismissNotificationCommand}"
                    Margin="0,0,0,12" />

        <!-- Split Workspace Area: Draggable Splitter with minimum widths for both panes -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,380">
            <!-- Left: Screenshot Preview Card -->
            <Border Grid.Column="0" MinWidth="260"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" ClipToBounds="True">
                <Panel>
                    <Image Source="{Binding ScreenshotBitmap}"
                           Stretch="Uniform"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           Margin="8" />

                    <!-- Empty State Placeholder -->
                    <StackPanel IsVisible="{Binding !HasScreenshot}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Spacing="10">
                        <ui:SymbolIcon Symbol="Camera" FontSize="48"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        <TextBlock Text="{DynamicResource Ui_49d53254fd13}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock Text="{DynamicResource Ui_b9f95095c112}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   HorizontalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="8,4" IsVisible="{Binding HasCropRegion}">
                        <TextBlock Text="{Binding CropRegionText}" FontSize="11" />
                    </Border>

                    <Canvas x:Name="ScreenshotCanvas" Background="#01000000"
                            PointerPressed="OnScreenshotPointerPressed"
                            PointerMoved="OnScreenshotPointerMoved"
                            PointerReleased="OnScreenshotPointerReleased">
                        <Border x:Name="CropSelection" Width="0" Height="0" IsHitTestVisible="False"
                                IsVisible="{Binding HasCropRegion}"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="2"
                                Background="#263B82F6" />
                    </Canvas>

                    <!-- Capturing Progress -->
                    <ProgressBar IsIndeterminate="True"
                                 IsVisible="{Binding IsCapturing}"
                                 Width="180" Height="4"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
            </Border>

            <!-- Column Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent"
                          ResizeDirection="Columns" Margin="3,0" />

            <!-- Right: OCR Results Inspector Card (Adaptive vertical sharing, no forced outer scrollbar) -->
            <Border Grid.Column="2" MinWidth="310" MaxWidth="580"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="14">
                <Grid RowDefinitions="Auto,1.2*,Auto,*,Auto,Auto">
                    <!-- Section 1 Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Ui_b2317ec564a7}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                CornerRadius="4" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DetectionCount, StringFormat='{}{0} 项'}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                    </Grid>

                    <!-- Detections List (Flexibly takes available vertical space) -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding OcrDetections}"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             CornerRadius="6" Padding="4" MinHeight="70">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:OcrItemViewModel">
                                <Border BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                                        BorderThickness="0,0,0,1" Padding="4,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="2">
                                            <TextBlock Text="{Binding Text}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BoundsText}" FontSize="10"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding ConfidenceText}" FontSize="11"
                                                   FontWeight="SemiBold" Foreground="#107C41"
                                                   VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Section 2 Header (With text ellipsis & tooltip to prevent right-edge clipping) -->
                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,10,0,6">
                        <TextBlock Grid.Column="0" Text="{DynamicResource Ui_d5be29b99b19}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Grid.Column="2" Text="{Binding OcrResultLanguageText}" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"
                                   ToolTip.Tip="{Binding OcrResultLanguageText}" />
                    </Grid>

                    <!-- Raw Text Box (Flexibly takes available vertical space) -->
                    <TextBox Grid.Row="3" Text="{Binding AllRecognizedText}"
                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                             Background="{DynamicResource ControlFillColorDefaultBrush}"
                             FontSize="12" FontFamily="Menlo, Monaco, Consolas, Courier New, monospace"
                             MinHeight="60" />

                    <!-- Section 3 Header: Template Matching -->
                    <TextBlock Grid.Row="4" Text="{DynamicResource Ui_8b8221e79a8e}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,10,0,6" TextWrapping="Wrap" />

                    <!-- Template Matching Controls: Clean, 2-row adaptive layout without squashing -->
                    <StackPanel Grid.Row="5" Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding TemplateImagePath}" Watermark="{DynamicResource Ui_9c411261e80c}" Margin="0,0,6,0" />
                            <Button Grid.Column="1" Click="OnChooseTemplateClick" Content="{DynamicResource Ui_ef23ea67b002}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*,Auto">
                            <StackPanel Grid.Column="0" Spacing="3" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Ui_60f424bf4ef4}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <ComboBox ItemsSource="{Binding AvailableTemplateMatchMethods}"
                                          SelectedItem="{Binding TemplateMatchMethod}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,6,0">
                                <TextBlock Text="{DynamicResource Ui_a05320e189cb}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <TextBox Text="{Binding TemplateMatchThreshold}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                            <Button Grid.Column="2" Command="{Binding MatchTemplateCommand}"
                                    IsEnabled="{Binding !IsMatchingTemplate}"
                                    VerticalAlignment="Bottom" Height="32" Padding="12,0">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Find" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource Ui_0b5d7ed54bee}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding TemplateMatchResultText}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
